   328│ // Returns true when the node has accumulated >= 2 consecutive
   329│ // transient stalls without ever reaching a terminal emit. This
   330│ // catches the production-trace pattern where the LLM rotated
   331│ // navigation tactics between rounds (different tool sequences) but
   332│ // failed to reach emit_change_plan in either. Because bursty EOF /
   333│ // dial failures can produce the same no-emit shape, callers must not
   334│ // use this predicate alone as a hard gate.
   335│ //
   336│ // The threshold is fixed at 2 (one initial stall + one retry stall
   337│ // that also fails the same way). Configurable would be over-design
   338│ // for an advisory signal.
   339│ func (s *graphState) transientNoEmitPlateau(nodeID string) bool {
   340│ 	if s == nil || s.transientNoEmitStreak == nil {
   341│ 		return false
   342│ 	}
   343│ 	return s.transientNoEmitStreak[nodeID] >= 2
   344│ }
   345│ 
   346│ // recordRetryByKind bumps the Session 11 C6 per-kind counter so
   347│ // shouldKillRetryByKind can apply the configured per-kind cap on
   348│ // the next iteration.
   349│ func (s *graphState) recordRetryByKind(kind types.ViolationKind) {
   350│ 	if s == nil {
   351│ 		return
   352│ 	}
   353│ 	if s.retryUsedByKind == nil {
   354│ 		s.retryUsedByKind = make(map[types.ViolationKind]int)
   355│ 	}
   356│ 	s.retryUsedByKind[kind]++
   357│ }
