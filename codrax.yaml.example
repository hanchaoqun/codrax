# =============================================================================
# codrax runtime settings — copy to codrax.yaml (next to the binary) to activate.
# =============================================================================
#
# Two YAML files live alongside the binary, each with a distinct role.
# Do not duplicate keys across them:
#
#   providers.yaml — LLM provider credentials and per-agent model
#                    routing. Per-user secrets, never committed.
#
#   codrax.yaml    — THIS FILE. Per-process runtime knobs: where to
#                    write logs and memory, default response language,
#                    per-invocation targets (repo, branch), global
#                    step budget, tool blob sizing, pipeline budgets,
#                    and a pointer to providers.yaml.
#
# The pipeline topology (4 stages × 4 agents) is hardcoded in
# internal/orchestrator/topology.go and has no YAML counterpart.
#
# Precedence (lowest wins last):
#
#   code defaults  <  <exeDir>/codrax.yaml  <  command-line flags
#
# Every key is optional — omitted keys fall through to the code default.
# The binary silently falls back to defaults when this file is missing,
# so checking in an example while leaving the real file out of version
# control is the expected workflow.
#
# Anchors:
#
#   - Configuration paths (providers_config) are anchored to the
#     binary's own directory (exeDir) when written as relative values.
#   - Runtime artifact paths (log_dir, memory_dir, cache_dir) are
#     anchored to <CWD>/.codrax/ when written as relative values.
#
# To point at a different runtime settings file without editing this
# path, set the CODRAX_SETTINGS environment variable.

# ---------------------------------------------------------------------------
# Log sink
# ---------------------------------------------------------------------------

# Directory for rotating log files. Created on first run.
# Relative values anchor to <CWD>/.codrax/ (so the default lands at
# <CWD>/.codrax/logs/<repo-slug>/); pass an absolute path to override.
# log_dir: logs

# Minimum level written to the log file. One of: error, warning, info, debug.
# Default: debug — the [CGEC] enforcer trace and [diag analyzer/explorer]
# iteration dumps are emitted at debug level; lower levels hide them.
# log_level: debug

# Mirror every log record to stdout in addition to the file.
# Useful for foreground debugging; keep off for clean REPL UX.
# log_stdout: false

# Maximum log files retained per directory. Rotation keeps the most
# recent N files (PID-aware: files owned by live peer processes are
# never deleted). 0 falls back to the code default (7).
# log_max_files: 7

# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------

# Directory for multi-turn conversation memory (MEMORY.md + turns/).
# Relative values anchor to <CWD>/.codrax/ (default: <CWD>/.codrax/memory/<repo-slug>/).
# memory_dir: memory

# Base directory for repo map caches (symbol index, relations, etc.).
# Each target repo gets its own subdirectory under <cache_dir>/repomap/.
# Default (when omitted): platform cache dir — ~/.cache/codrax (Linux),
# ~/Library/Caches/codrax (macOS), %LocalAppData%\codrax (Windows).
# Relative values anchor to <CWD>/.codrax/ (opts in to per-workspace caches).
# cache_dir:

# ---------------------------------------------------------------------------
# Tool output blobs
# ---------------------------------------------------------------------------

# Maximum blob session directories retained under <CWD>/.codrax/blob/.
# Each codrax process creates one session dir named <timestamp>-<pid>/
# on startup. Prune runs at next startup; live peer sessions are never
# deleted (mirrors log_max_files). 0 disables persistent sessions
# entirely and reverts to per-trace tmpdir (cleaned at Run end).
# blob_max_sessions: 7

# ---------------------------------------------------------------------------
# Response language
# ---------------------------------------------------------------------------

# Default response language for the model's final answer.
# Supported shorthands: zh, zh-CN, en. Any other string is passed
# through verbatim as a preference directive. Set to "off" or "none"
# to disable the feature entirely (model picks its own language).
# lang: zh

# ---------------------------------------------------------------------------
# Per-invocation target
# ---------------------------------------------------------------------------

# Target repository the agents operate on.
# repo: .

# Default git branch for the working context.
# branch: main

# ---------------------------------------------------------------------------
# Tool output blob sizing
# ---------------------------------------------------------------------------
# Tool results larger than blob_max_inline_bytes are offloaded to a
# blob file under the work dir; only a head+tail preview is inlined
# into the LLM context.

# blob_max_inline_bytes: 32768
# blob_preview_head_bytes: 24576
# blob_preview_tail_bytes: 4096

# ---------------------------------------------------------------------------
# read_file tool
# ---------------------------------------------------------------------------
# On an inline-sized file (bytes <= blob_max_inline_bytes), read_file
# treats offset=0 combined with a small limit as a "training-distribution
# default" and expands the slice to the whole file. This protects against
# the common LLM failure mode of picking limit=20 on a 66-line source
# file and silently missing the answer past line 20. Any non-zero offset
# is always honored (a deliberate keyhole read), and a Limit above the
# threshold is always honored. Banner makes the override visible.
#
# Set to 0 to disable the override entirely — offset/limit is then
# honored on any file size.

# readfile_small_limit_threshold: 100

# ---------------------------------------------------------------------------
# Pipeline budgets
# ---------------------------------------------------------------------------
# How much work the pipeline is allowed to do per Run() call.
# CLI flags (-pipeline-max-steps, -pipeline-max-retries,
# -pipeline-max-stage-visits) override these.

# pipeline_max_steps: 50
# pipeline_max_retries_per_stage: 3
# pipeline_max_stage_visits: 4

# ---------------------------------------------------------------------------
# Analyzer quality gate (gate_*)
# ---------------------------------------------------------------------------
# Thresholds for the deterministic quality gate that runs after
# emit_analysis. All optional — zero falls through to code default.

# gate_coverage_min: 0.6
# gate_coverage_weight_symbol: 1.0
# gate_coverage_weight_config: 0.7
# gate_coverage_weight_concept: 0.4
# gate_hypothesis_min_priority: 0

# ---------------------------------------------------------------------------
# emit_analysis runtime validation (analysis_*)
# ---------------------------------------------------------------------------
# Controls keyword/entity validation during the analyze stage.

# Soft floor: attach a warning when keyword count is below this.
# analysis_warn_below_keywords: 8

# Hard floor: fail emit_analysis when keyword count is below this. 0 = disabled.
# analysis_reject_below_keywords: 0

# Generic nouns dropped from entities to prevent ERM poisoning.
# Set to [] to disable the filter.
# analysis_generic_entity_blocklist:
#   - count
#   - function
#   - thing
#   - agent
#   - handler
#   - module

# When true, a second emit_analysis call in one dispatch sets StageOutput.Error.
# analysis_reject_multiple_emit: false

# Max pre-scan rounds before force-stop. 0 = disabled.
# analysis_max_prescan_rounds: 2

# Soft floor for keyword/entity hit ratio in pre-scan blob. 0 = disabled.
# analysis_warn_below_keyword_hit_ratio: 0
# analysis_warn_below_entity_hit_ratio: 0

# ---------------------------------------------------------------------------
# Evidence grounding (evidence_*)
# ---------------------------------------------------------------------------
# The grounder (internal/tool/ground) validates every LLM-emitted evidence
# item at emit_evidence.Execute time: Tier 1 checks the read_file gutter
# at source:line for the anchor_symbol token; Tier 2 consults the repomap
# symbol table (definition / call / import). Recovery tiers R1-R5 rewrite
# near-miss LineStart / Source to repair LLM off-by-one mistakes. Items
# that fail every tier are marked ungrounded and routed to the
# "Unverified Leads" section (not citable but visible).
#
# emit_investigation_complete then requires
#   (grounded + recovered) / total >= evidence_grounding_floor
# before accepting the completion signal. A miss returns a rejection
# listing every ungrounded item with concrete repair options so the LLM
# can fix on the next turn without a stage round-trip.

# Minimum grounded ratio required by emit_investigation_complete.
# Range [0, 1]. 0 disables the gate entirely; 1 requires every item grounded.
# Default 0.5 — high enough to block a mostly-speculative investigation,
# low enough that a handful of leads do not deadlock the pipeline.
# evidence_grounding_floor: 0.5

# ---------------------------------------------------------------------------
# Explorer heuristics (explore_*)
# ---------------------------------------------------------------------------
# Tunable thresholds for the explorer evaluator's mid-loop and
# soft-stop detection branches. Zero = code default.

# --- Mid-loop detection ---
# explore_midloop_min_iteration: 2
# explore_serial_batch_threshold: 2
# explore_serial_streak_threshold: 2
# explore_partial_read_line_threshold: 150
# explore_midloop_enum_coverage: 0.6
# explore_parallel_unread_floor: 2
# explore_enum_midloop_unread_floor: 2

# --- Soft-stop detection ---
# explore_softstop_enum_coverage: 0.8
# explore_phase0_min_discovered_files: 3
# explore_phase0_max_broaden_attempts: 2
# explore_symbol_min_len_method: 3
# explore_symbol_min_len_other: 8
# explore_max_prescanned_pushes: 3
# explore_erm_suggest_limit: 3

# --- Display ---
# explore_cv_preview_max_len: 1500

# --- Sourcemix budget ---
# explore_per_tool_default_cap: 0

# ---------------------------------------------------------------------------
# CGEC — Citation-Grounded Evidence Closure (cgec_*)
# ---------------------------------------------------------------------------
# CGEC is the cross-stage closure tracker that enforces four
# invariants between the chain producer, the citation grounder, the
# completion gate, and the convergence detector. The defaults below
# are the values the unit + e2e tests pin against.
#
# I1 (chain promotion) and I2 (grounder repair) have no per-deployment
# knobs — they are always on. I3 (pre-complete check) is also always
# on. Only I4 (Lazy Auto-Read + convergence detector) is tunable.

# Maximum files the framework reads on the LLM's behalf per explore
# round when chain-promotion / grounder-rejected files queue up as
# PendingReads. Default 3. Setting 0 DISABLES Lazy Auto-Read entirely
# (the LLM is on its own — mirrors analysis_max_prescan_rounds:0
# disable semantics); setting too high can break ReAct autonomy.
# Negative values are ignored (treated as operator error).
# cgec_forced_reads_per_round: 3

# Convergence detector soft threshold. After this many consecutive
# explore rounds with identical (ReadSet, Evidence, ChainTerm,
# CitedRefs) 4-dim fingerprints, the orchestrator triggers Lazy
# Auto-Read to try to break the stall AND emits a RepairExpandSearch
# directive. Default 2. Setting 0 DISABLES soft-stall detection
# entirely (no Lazy Auto-Read, no RepairExpandSearch from the stall
# path). Negative values ignored.
# cgec_stall_threshold_soft: 2

# Convergence detector hard threshold. After this many consecutive
# identical fingerprints AND no force-read fired, the orchestrator
# emits RepairForceCompleteDowngrade + SetInvestigationComplete so
# the finalizer can ship a best-effort answer instead of looping
# until budget exhaustion. Default 3 (must be >= cgec_stall_threshold_soft).
# Setting 0 DISABLES hard stall (operator who wants observability
# via Stats but NO force-complete sets hard=0). Negative values
# ignored.
# cgec_stall_threshold_hard: 3

# ---------------------------------------------------------------------------
# Agent limits (agent_*)
# ---------------------------------------------------------------------------
# Per-agent behavioral limits: iteration caps, tool-history budget,
# LoopPolicy defaults, correction retries, investigation_complete policy.

# ReAct loop ceiling for all agents. Default 20. When the loop hits
# this ceiling while the LLM is still tool-calling, the dispatch is
# hard-cut — Fallback S1 only rescues soft-stops, not ceiling cuts.
# Multi-topic scaling in orchestrator.go adds SubTopicExplorerBudgetExtra
# × subTopics on top, capped at 35; single-topic questions get no
# scaling, so lowering this trades iteration headroom for wall time.
# agent_max_iterations: 20

# Cumulative byte budget for "tool" role messages before pruning.
# agent_max_tool_history_bytes: 153600

# LoopPolicy: minimum iterations between two accepted hint injections.
# agent_loop_min_inject_interval: 3

# LoopPolicy: max soft-stop continuation hints per dispatch.
# agent_loop_max_continuations: 5

# LoopPolicy: max mid-loop hint injections per dispatch.
# agent_loop_max_midloop_injects: 6

# LoopPolicy: consecutive idle iterations before force-stop.
# agent_loop_idle_stop_threshold: 2

# Finalizer: max correction retries when emit_answer_document is missing.
# agent_finalizer_max_correction_retries: 2

# Finalizer shrinkage salvage: when the model first writes a rich prose
# answer outside the tool call, then on the correction retry emits a
# compressed paraphrase as `summary`, ParseOutput replaces the shrunken
# summary with the richer prior draft. Scoped to shape=explanation only.
#
# Master switch. Default true. Set to false to disable the salvage
# entirely (the retry's shorter summary is rendered as-is).
# agent_finalizer_preserve_prior_prose: true

# Minimum bytes the prior prose draft must have to qualify for salvage.
# Shorter drafts are treated as placeholder content, not a real answer.
# Default 400.
# agent_finalizer_shrinkage_min_prose_len: 400

# Ratio threshold len(summary)/len(prior) below which the summary is
# considered "shrunken" and the prior draft is copied in. Default 0.5.
# agent_finalizer_shrinkage_ratio: 0.5

# Extractor: max correction retries when emit_answer_symbol is missing.
# agent_extractor_max_correction_retries: 1

# --- Multi-topic adaptive budget scaling ---
# When RequestModel.SubTopics has >1 entries, these knobs control how
# much extra budget each sub-topic adds. All values have sensible
# defaults; zero-config works out of the box.

# Extra prescan rounds per 2 sub-topics. Adjusted prescan is capped at base+2 (max 4).
# agent_subtopic_prescan_extra: 1

# Extra explorer iterations per sub-topic. Adjusted MaxIterations capped at 35.
# agent_subtopic_explorer_extra: 3

# Extra pipeline steps per sub-topic. Adjusted step budget capped at 100.
# agent_subtopic_pipeline_extra: 5

# Extra retry budget per 2 sub-topics. Adjusted retry budget capped at 5.
# agent_subtopic_retry_extra: 1

# How the DAG scheduler treats explore nodes when emit_investigation_complete
# was called but SuccessCriteria (e.g. evidence_count>=3) still fail:
#   "soft"     — lower evidence_count threshold to >=1 (default)
#   "override" — skip criteria entirely, mark all explore nodes done.
#                SIDE EFFECT: CGEC preCompleteContractCheck also skips
#                all 6 checks (a-f) — the DAG scheduler's "bypass
#                criteria" directive implies the pre-complete gates
#                should also be bypassed to stay consistent. Downgrade
#                messages, RepairExpandSearch / RepairSwapShape /
#                RepairRebindSubject from pre-complete all suppressed.
#   "strict"   — ignore the signal, enforce template thresholds
# agent_investigation_complete_policy: soft

# ---------------------------------------------------------------------------
# Summary length caps (summary_cap_*)
# ---------------------------------------------------------------------------
# emit_answer_document can enforce per-shape ceilings on the `summary`
# field. Length control is a MASTER-SWITCHED feature: the default is
# OFF, so the finalizer's emitted summary is accepted as-is and the
# shrinkage-salvage trimmer never trims. Flip summary_cap_enabled:true
# to activate the per-shape numbers below.
#
# When enabled, scalar shapes (explanation / value / config_value /
# boolean) carry fixed ceilings; step_list and list_of_symbols scale
# with the number of items so a long list is not compressed to the
# same budget as a short one:
#
#   step_list        cap = min(step_list_max,  step_list_base  + n * step_list_per_item)
#   list_of_symbols  cap = min(symbols_max,    symbols_base    + n * symbols_per_item)
#
# The caps are read from types.SummaryCapConfig at runtime; codrax.yaml
# overrides here take effect at process start. Every key is optional —
# omitted keys fall through to the code default.

# Master switch. Default false — no length enforcement runs anywhere
# and the numeric knobs below are inert. Set to true to activate
# per-shape caps.
# summary_cap_enabled: false

# Explanation shape: summary IS the answer body (thorough multi-paragraph
# prose with code-level specifics + cross-file relationships). Default 2500.
# summary_cap_explanation: 2500

# Value / ConfigValue shapes: summary is a 1-sentence lead-in before a
# scalar literal. Default 500.
# summary_cap_value: 500
# summary_cap_config_value: 500

# Boolean shape: summary is a lead-in before YES/NO + rationale. Default 800.
# summary_cap_boolean: 800

# StepList shape: base + per-step slope, capped at max. Defaults produce
# 1000 (0 steps) → 1240 (2 steps) → 2200 (10 steps) → 2500 (≥13 steps).
# summary_cap_step_list_base: 1000
# summary_cap_step_list_per_item: 120
# summary_cap_step_list_max: 2500

# ListOfSymbols shape: same shape of scaling as step_list, slightly
# shallower per-item slope because the symbols carry most content.
# Defaults: 1000 → 1200 (2 symbols) → 2000 (10 symbols) → 2500 (≥15).
# summary_cap_symbols_base: 1000
# summary_cap_symbols_per_item: 100
# summary_cap_symbols_max: 2500

# Fallback cap for any shape not covered above. Default 500.
# summary_cap_default: 500

# ---------------------------------------------------------------------------
# Memory store limits (memory_*)
# ---------------------------------------------------------------------------
# Multi-turn REPL memory: buffer sizes and context-building caps.

# Number of recent turns kept verbatim before LLM-summarization.
# memory_max_recent_turns: 6

# Total byte budget for the recent turn buffer.
# memory_max_recent_bytes: 20480

# Max size of a single turn's request+response stored to disk.
# memory_max_turn_body_bytes: 65536

# Max compacted index entries whose Summary is inlined into
# BuildContext per request. Full turn text is never inlined — only
# the LLM-generated one-line summary.
# memory_max_build_context_matches: 3

# ---------------------------------------------------------------------------
# Log-triage (log_triage_*)
# ---------------------------------------------------------------------------
# When the user attaches a runtime log excerpt via --log / --log-text /
# REPL /log, a conditional pre-stage (the log_triager agent) runs an
# LLM-driven extractor that emits a structured LogBundle (errors +
# frames + signals + residue). The system validates paths against the
# repository and derives the resolved-file list. The analyzer then
# reads the bundle to seed AnalyzerHints.Entities and
# EvidencePlan.RequiredFiles.
#
# Generalization note: unlike session 19's regex-per-format approach,
# the LLM extractor handles Rust / Ruby / custom application JSON
# logs / compiler output uniformly with zero parser-per-format code.
# The system guards against hallucinations via os.Stat path
# verification and runtime-internal filters.

# Global feature gate. When false, the log_triager agent's Guard
# returns false regardless of AttachedLog and the pre-stage is skipped
# entirely. The --log flag still reads the file but the payload is
# not extracted. Default true.
# log_triage_enabled: true

# User-provided build-path prefix for stack-frame files from CI /
# build machines. C/C++ traces commonly carry absolute paths like
# `/build/src/...` or `/home/jenkins/workspace/.../src/...` that the
# built-in cascading stripper can miss. Tried FIRST before the
# built-in CI root list. Mirrored by the CLI flag
# --log-source-prefix — when both are set the CLI flag wins.
# log_triage_source_prefix: ""

# Minimum log size (bytes) below which the pre-stage is skipped.
# Very short logs (a single error line) rarely contain extractable
# frames; the LLM call cost outweighs the benefit. Default 50.
# log_triage_min_bytes: 50

# Fail-loud retry budget for emit_log_triage schema rejections.
# 0 = never retry (degrade to nil bundle). Default 1.
# log_triage_max_retries: 1

# Two-step fallback master switch. When false, oversized / low-coverage
# logs take the single-shot result (or nil on failure) without
# attempting segmentation. Default true.
# log_triage_two_step_enabled: true

# Byte threshold above which the pre-stage goes straight to two-step
# (bypasses single-shot). Conservative default so single-shot handles
# the common short-panic case; only polyglot / multi-cycle / k8s
# aggregated logs pay the segmentation cost. Default 32768 (32 KB).
# log_triage_two_step_bytes: 32768

# Coverage threshold below which a single-shot bundle escalates to
# two-step. Coverage = 1 - bytes(unknown_chunks) / bytes(rawLog).
# Default 0.3 (under 30% structured → escalate).
# log_triage_two_step_coverage: 0.3

# Hard cap on total LLM invocations for one pre-stage Run (covers
# 1 single-shot + 1 segmentation + N per-segment extractions).
# Defence against runaway segmentation. Default 8.
# log_triage_max_llm_calls: 8

# ---------------------------------------------------------------------------
# Path to providers config
# ---------------------------------------------------------------------------
# Keeping this here means `CODRAX_SETTINGS=envs/prod/codrax.yaml`
# bootstraps an entire environment from a single entry point.

# providers_config: providers.yaml
