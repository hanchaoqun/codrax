# =============================================================================
# codrax runtime settings — copy to codrax.yaml (next to the binary) to activate.
# =============================================================================
#
# Two YAML files live alongside the binary, each with a distinct role.
# Do not duplicate keys across them:
#
#   providers.yaml — LLM provider credentials and per-agent model
#                    routing. Per-user secrets, never committed.
#
#   codrax.yaml    — THIS FILE. Per-process runtime knobs: where to
#                    write logs and memory, default response language,
#                    per-invocation targets (repo, branch), global
#                    step budget, tool blob sizing, pipeline budgets,
#                    and a pointer to providers.yaml.
#
# The pipeline topology (4 stages × 4 agents) is hardcoded in
# internal/orchestrator/topology.go and has no YAML counterpart.
#
# Precedence (lowest wins last):
#
#   code defaults  <  <exeDir>/codrax.yaml  <  command-line flags
#
# Every key is optional — omitted keys fall through to the code default.
# The binary silently falls back to defaults when this file is missing,
# so checking in an example while leaving the real file out of version
# control is the expected workflow.
#
# Anchors:
#
#   - Configuration paths (providers_config) are anchored to the
#     binary's own directory (exeDir) when written as relative values.
#   - Runtime artifact paths (log_dir, memory_dir, cache_dir) are
#     anchored to <CWD>/.codrax/ when written as relative values.
#
# To point at a different runtime settings file without editing this
# path, set the CODRAX_SETTINGS environment variable.

# ---------------------------------------------------------------------------
# Log sink
# ---------------------------------------------------------------------------

# Directory for rotating log files. Created on first run.
# Relative values anchor to <CWD>/.codrax/ (so the default lands at
# <CWD>/.codrax/logs/<repo-slug>/); pass an absolute path to override.
# log_dir: logs

# Minimum level written to the log file. One of: error, warning, info, debug.
# Default: debug — the [CGEC] enforcer trace and [diag analyzer/explorer]
# iteration dumps are emitted at debug level; lower levels hide them.
# log_level: debug

# Mirror every log record to stdout in addition to the file.
# Useful for foreground debugging; keep off for clean REPL UX.
# log_stdout: false

# Print model thinking lines in full in CLI and REPL by default.
# Set to true only when you prefer the legacy compact 1-2 sentence
# terminal summary over full traceability.
# thinking_truncate: false

# Maximum log files retained per directory. Rotation keeps the most
# recent N files (PID-aware: files owned by live peer processes are
# never deleted). 0 falls back to the code default (7).
# log_max_files: 7

# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------

# Directory for multi-turn conversation memory (MEMORY.md + turns/).
# Relative values anchor to <CWD>/.codrax/ (default: <CWD>/.codrax/memory/<repo-slug>/).
# memory_dir: memory

# Base directory for repo map caches (symbol index, relations, etc.).
# Each target repo gets its own subdirectory under <cache_dir>/repomap/.
# Default (when omitted): ~/.codrax/cache/ (the same parent directory the
# env_recommend disk cache lives under, so all cross-project per-user
# codrax state is in one well-known place).
# Per-platform via os.UserHomeDir():
#   Linux / macOS: ~/.codrax/cache/
#   Windows:       %USERPROFILE%\.codrax\cache\
# Relative values anchor to <CWD>/.codrax/ (opts in to per-workspace caches).
# cache_dir:

# ---------------------------------------------------------------------------
# Tool output blobs
# ---------------------------------------------------------------------------

# Maximum blob session directories retained under <CWD>/.codrax/blob/.
# Each codrax process creates one session dir named <timestamp>-<pid>/
# on startup. Prune runs at next startup; live peer sessions are never
# deleted (mirrors log_max_files). 0 disables persistent sessions
# entirely and reverts to per-trace tmpdir (cleaned at Run end).
# blob_max_sessions: 7

# ---------------------------------------------------------------------------
# Final-answer transcript dump
# ---------------------------------------------------------------------------
# At the end of every read-mode Run that successfully landed an
# AnswerDocumentV2, the orchestrator writes a markdown transcript of
# what the user just saw to <CWD>/.codrax/output/<timestamp>-<pid>.md.
# The file carries exactly two H1 sections:
#
#   # 问题   — the user's request, plus optional `> 附件: log (… KiB)` /
#             `> 附件: htrace (… KiB)` footnotes when --log / --htrace
#             / --atrace was attached
#   # 回答   — the rendered markdown body, byte-identical to what the
#             one-shot CLI prints to stdout (REPL applies glamour on top;
#             this file captures the pre-glamour source)
#
# Diagram fences (```mermaid) are kept verbatim — the file mirrors the
# model's output, not a re-rendering. Whether downstream viewers (GitHub,
# VSCode mermaid plugin) draw the diagrams is the viewer's choice.
#
# Write modes (plan / apply / verify) do NOT dump — only read-mode
# answers. Failed Runs that never landed a V2 carrier are skipped so
# only the answer the user actually saw is ever written.
#
# Retention: each dump prunes the oldest *.md files in the directory
# until count <= output_max_files - 1, then writes the new file. Other
# files in the directory are left alone.

# Master switch. Default true — every read-mode answer is captured.
# Set false to disable the feature entirely (no directory created).
# output_dump_enabled: true

# Maximum *.md files retained under <CWD>/.codrax/output/. The oldest
# (by mtime) are pruned before each new write so the directory never
# grows past this cap. Default 10. Non-positive resets to default.
# output_max_files: 10

# ---------------------------------------------------------------------------
# Response language
# ---------------------------------------------------------------------------

# Default response language for the model's final answer.
# Supported shorthands: zh, zh-CN, en. Any other string is passed
# through verbatim as a preference directive. Set to "off" or "none"
# to disable the feature entirely (model picks its own language).
# lang: zh

# ---------------------------------------------------------------------------
# Per-invocation target
# ---------------------------------------------------------------------------

# Target repository the agents operate on.
# repo: .

# Default git branch for the working context.
# branch: main

# ---------------------------------------------------------------------------
# Tool output blob sizing
# ---------------------------------------------------------------------------
# Tool results larger than blob_max_inline_bytes are offloaded to a
# blob file under the work dir; only a head+tail preview is inlined
# into the LLM context.

# blob_max_inline_bytes: 32768
# blob_preview_head_bytes: 24576
# blob_preview_tail_bytes: 4096

# Fraction form of blob_max_inline_bytes. When set AND providers.yaml
# declares context_window, effective bytes = context_window × fraction
# × 4 (B/token). Takes precedence over blob_max_inline_bytes; falls
# back to that absolute when context_window is unknown, then to code
# default. This lets one value scale across heterogeneous models —
# on a 1M-window model 0.02 yields ~80 KB, on an 8K-window model
# the same 0.02 yields ~640 B.
# blob_max_inline_fraction: 0.02

# ---------------------------------------------------------------------------
# read_file tool
# ---------------------------------------------------------------------------
# On an inline-sized file (bytes <= blob_max_inline_bytes), read_file
# treats offset=0 combined with a small limit as a "training-distribution
# default" and expands the slice to the whole file. This protects against
# the common LLM failure mode of picking limit=20 on a 66-line source
# file and silently missing the answer past line 20. Any non-zero offset
# is always honored (a deliberate keyhole read), and a Limit above the
# threshold is always honored. Banner makes the override visible.
#
# Set to 0 to disable the override entirely — offset/limit is then
# honored on any file size.

# readfile_small_limit_threshold: 100

# ---------------------------------------------------------------------------
# Pipeline budgets
# ---------------------------------------------------------------------------
# How much work the pipeline is allowed to do per Run() call.
# CLI flags (-pipeline-max-steps, -pipeline-max-retries,
# -pipeline-max-stage-visits) override these.

# pipeline_max_steps: 50
# pipeline_max_retries_per_stage: 2
# pipeline_max_stage_visits: 4

# Transient (read-mode) retry. Caps how many times the scheduler
# re-dispatches a stage that hit a STREAM-LEVEL transient error
# (unexpected EOF / stream stalled / first-byte timeout / network
# blip). HTTP 429 / 5xx are NOT in this set — those are L1's domain
# (providers.yaml :: retry_max_attempts, default 6 attempts × ~62s
# coverage). Decoupled from write_retry_budget so brief upstream
# blips never starve the verify→plan SC retry budget. Default 1
# rides through a single connection drop without burning more LLM
# budget.
# pipeline_transient_retry_budget: 1

# Force-finalize fallback retry. The orchestrator's last-resort
# composition path (fires after the regular DAG path stalls or
# rejects every draft) retries up to this many times when the
# dispatch hits a stream-level transient error. Default 3 = 1
# initial + 2 retries with llm.NextRetryDelay backoff (capped at
# 5s). This is the user's last chance to recover ANY answer when
# the connection is flaky; without retries here, a single EOF
# would surface as "forced finalize: read stream: unexpected EOF"
# with no answer at all. Hard-capped at 5 inside the orchestrator.
# pipeline_force_finalize_attempts: 3

# Absolute ceilings on per-Run multi-topic budget scaling. Non-zero
# overrides the historical hardcoded literals; zero falls back to the
# code default shown after each key.
# pipeline_max_steps_ceil: 100
# pipeline_write_retry_budget_ceil: 5
# pipeline_transient_retry_budget_ceil: 3

# Write-mode-only pipeline knobs. No-op when write_enabled: false.

# verify→plan retry loop. When >0 and the verify stage fails, the
# orchestrator seeds a PlanningHint from the ChangeReport's failure
# summary + top-3 failing tests + plan.TargetPaths (suspect files),
# resets ChangePlan / ChangeReport / WriteClosure / plan-path, and
# re-enters plan. Default 3 — Reflexion / Self-Refine / AutoCodeRover
# literature consensus is 3-5; past 5 is marginal lift and burns
# tokens on unfixable plans. Hard cap pipeline_write_retry_budget_ceil
# (default 5) is enforced inside SetWriteRetryBudget.
# pipeline_write_retry_budget: 3

# Baseline capture. When true, the apply pre-hook runs run_tests
# against the worktree BEFORE the coder dispatches (post-provision,
# pre-apply) so the CritNoRegression criterion can compare pre/post
# MetricDeltas. Doubles test-suite wall time — leave false unless
# the repo has known pre-existing regressions to distinguish from
# newly-introduced ones.
# pipeline_baseline_capture_enabled: false

# Preserve the apply-phase worktree when Mode=ModeApply completes with
# LastError=="". Failure paths (apply failed / verify failed) always
# discard to avoid disk clutter. When preserved, the absolute worktree
# path is written to plan.WorktreePath so /worktree list and cherry-
# pick workflows can find it. Default false — worktree is an internal
# sandbox, not a user artefact.
# pipeline_keep_worktree_on_success: false

# ---------------------------------------------------------------------------
# Stage II: multi-phase plan groups (commits 18-33)
# ---------------------------------------------------------------------------
# When the LLM's PhaseProposal carries split=sequential with N >= 2 phases
# AND Mode=ModeApply, the orchestrator drives plan→apply→verify per
# phase via runPhaseGroup. /phase show inspects state; /phase rollback
# resets the active phase to Pending; /phase resume hints next steps.

# Cap on LLM-emitted PhaseProposal phase count. Default 5 (empirical:
# real-world multi-phase tasks are 2-3 phases; 5 covers the long tail;
# >5 almost always means the LLM mis-classified what should be a single
# phase). Hard-capped by types.MaxPhasesPerGroupCeil = 12 inside
# types.SetMaxPhases so a yaml typo can't unleash a 30-phase fan-out.
# pipeline_max_phases_per_run: 5

# ---------------------------------------------------------------------------
# Stage 3: per-repo Failure Taxonomy (commits 34-40)
# ---------------------------------------------------------------------------
# Cross-Run learning: every verify→plan retry asks the reflector LLM to
# distill the failure into an abstract reusable pitfall (name + trigger +
# description + confidence). Persisted at <cache-dir>/<repo-slug>/
# failure_taxonomy.json. Future plans in the same repo see the relevant
# pitfalls injected into the planner's "## Known active pitfalls" prompt
# section so the LLM can avoid them. /pitfalls list / show / clear at
# the REPL inspects the cache.

# Master switch. Default true. Set false to disable the entire learning
# loop — reflector still runs but emit_failure_pattern is omitted from
# its tools list (no LLM-token cost) and planner injection skips its
# pitfall section.
# pipeline_failure_taxonomy_enabled: true

# Cap on the per-repo cache size. Append-overflow drops the lowest-
# value entries (Confidence × HitCount × recency). Default 50, sized
# to fit ~3 KB worst-case prompt budget when all are injected.
# pipeline_failure_taxonomy_max_items: 50

# Decay window for one-off (HitCount<2) patterns. Patterns older than
# N days AND not seen since are dropped at next Append. Default 90 —
# matches the heuristic that a pattern unrepeated for 3 months was
# probably a one-off coincidence. Set 0 to disable decay (patterns
# persist forever).
# pipeline_failure_taxonomy_decay_days: 90

# ---------------------------------------------------------------------------
# Write mode (write_*)
# ---------------------------------------------------------------------------
# Write-mode is the plan → apply → verify pipeline that proposes and
# executes code changes inside a sandboxed git worktree. The master
# switch is yaml-only by design — write mode is a deploy-time
# decision, not per-run. With write_enabled: false (the default) any
# --mode=plan|apply|verify or REPL /mode plan|apply|verify is rejected
# fail-loud at flag-parse / command-handler time.

# Master switch. MUST be true for --mode=plan|apply|verify to dispatch.
# write_enabled: false

# Default --mode when the CLI flag is omitted. Legal values: "read"
# (default) or "plan". "apply" and "verify" are inherently side-
# effecting and MUST be opted into per-run via CLI — the yaml layer
# rejects them here with a clear error.
# write_default_mode: read

# Reserved for REPL /approve interactive default and batch workflows.
# Unused in single-shot today; the --auto-apply CLI flag is the
# authoritative gate for single-shot --mode=apply.
# write_auto_approval: false

# Override for the plan-JSON output directory. Default is
# <runtime-anchor>/plans/ (i.e. <CWD>/.codrax/plans/). Accepts absolute
# or runtime-anchor-relative paths; non-absolute forms are anchored in
# cmd/root.go.
# write_plan_dir: ""

# Authorize turning a non-git target directory into a git repo
# (`git init` + empty initial commit) at the start of a write-mode Run.
# CLI equivalent: --auto-init-repo. Default false. This authorizes the
# git-init step ONLY; if the directory is also empty and you want a
# brand-new project created from scratch, you ALSO need
# write_scaffold_enabled below. CLI flag wins when both are set. The
# REPL keeps an interactive y/N prompt as the third-tier fallback for
# init when neither yaml nor CLI is set.
# write_auto_init_repo: false

# Authorize the planner to invent files for a target directory that
# contains NO existing source (from-scratch project creation). CLI
# equivalent: --allow-scaffold. Default false. Required IN ADDITION TO
# write_auto_init_repo for empty-dir runs; non-empty bare directories
# bypass this gate (the planner has real source to read). Off by default
# so files are never fabricated without explicit consent.
# write_scaffold_enabled: false

# ---------------------------------------------------------------------------
# Worktree retention (worktree_keep_*)
# ---------------------------------------------------------------------------
# Bounds on the preserved worktrees produced by
# pipeline_keep_worktree_on_success: true. At codrax startup the runtime
# age-reaps then quota-evicts dirs under <runtime-anchor>/worktrees/
# so a long-running operator's disk doesn't fill silently. Failure-path
# worktrees are always discarded immediately and never appear here.

# TTL (in hours). Worktree dirs whose mtime is older than this are
# removed at codrax launch. 0 disables age-reaping entirely (quota
# still applies). Default 168 (7 days).
# worktree_keep_ttl_hours: 168

# Maximum number of preserved worktrees that may exist after age-
# reaping. When the survivor count exceeds this, the oldest (by mtime)
# are LRU-evicted until count <= cap. 0 disables the quota (only TTL
# applies). Default 20.
# worktree_keep_max_count: 20

# ---------------------------------------------------------------------------
# Verify resource caps (verify_mem_limit_mb / verify_cpu_limit_seconds)
# ---------------------------------------------------------------------------
# Hard caps on every supervised exec — applied to run_tests and
# exec_command invocations both in read mode (when used by the LLM
# directly) and in write-mode verify. Without these caps a runaway
# LLM-generated test (e.g. an unbounded allocator loop) can OOM the
# entire host. Provenance: 2026-04-26 OOM event where pytest hit
# RSS 2.47 GiB on a 3.7 GiB host and the system-wide OOM killer took
# down the supervising claude-code process.
#
# Unix: enforced via `ulimit -v` / `-t` shell prefix.
# Windows: enforced via JobObject JobMemoryLimit / PerJobUserTimeLimit.

# Memory cap in MiB. Default 2048 (2 GiB) — large enough for most real
# test suites (Java gradle, big Go monorepos), tight enough that a
# 4 GiB host keeps codrax + the test process alive together.
# Operators on dev hosts with abundant RAM can raise this; CI runners
# often want lower (e.g. 512). 0 falls back to the default.
# verify_mem_limit_mb: 2048

# Total CPU seconds across every process in the supervised tree.
# Distinct from the wall-clock timeout (300 s default) so a CPU-burner
# on a multi-core host can't keep all cores at 100 % for the full wall
# budget. Fires SIGXCPU on Unix, terminates the JobObject on Windows.
# Default 600. 0 falls back to the default.
# verify_cpu_limit_seconds: 600

# ---------------------------------------------------------------------------
# Static-check master switch (pipeline_lint_enabled)
# ---------------------------------------------------------------------------
# Gates the V5 lint validator family that runs at emit_change_plan
# time on every kind=create entry. Covers Go (gofmt -l), Python
# (ruff -E,F), Node (node --check), Ruby (ruby -wc), C (gcc -Werror),
# C++ (g++ -Werror), TypeScript (tsc --noEmit), Rust (rustc
# --emit=metadata), Java (javac -Xlint), Swift (swift -frontend
# -typecheck), plus project-aware ArkTS / Cangjie checks. Each check
# silently skips when its toolchain binary is missing. Set to false
# when your codebase carries existing lint debt and the new-files-only
# filter still feels too noisy. Default true.
# pipeline_lint_enabled: true

# ---------------------------------------------------------------------------
# Analyzer quality gate (gate_*)
# ---------------------------------------------------------------------------
# Thresholds for the deterministic quality gate that runs after
# emit_analysis. All optional — zero falls through to code default.

# gate_coverage_min: 0.6
# gate_coverage_weight_symbol: 1.0
# gate_coverage_weight_config: 0.7
# gate_coverage_weight_concept: 0.4
# gate_hypothesis_min_priority: 0

# ---------------------------------------------------------------------------
# emit_analysis runtime validation (analysis_*)
# ---------------------------------------------------------------------------
# Controls keyword/entity validation during the analyze stage.

# Soft floor: attach a warning when keyword count is below this.
# analysis_warn_below_keywords: 8

# Hard floor: fail emit_analysis when keyword count is below this. 0 = disabled.
# analysis_reject_below_keywords: 0

# Generic nouns dropped from entities to prevent ERM poisoning.
# Set to [] to disable the filter.
# analysis_generic_entity_blocklist:
#   - count
#   - function
#   - thing
#   - agent
#   - handler
#   - module

# When true, a second emit_analysis call in one dispatch sets StageOutput.Error.
# analysis_reject_multiple_emit: false

# Max pre-scan rounds before force-stop. 0 = disabled.
# analysis_max_prescan_rounds: 2

# Soft floor for keyword/entity hit ratio in pre-scan blob. 0 = disabled.
# analysis_warn_below_keyword_hit_ratio: 0
# analysis_warn_below_entity_hit_ratio: 0

# ---------------------------------------------------------------------------
# Evidence grounding (evidence_*)
# ---------------------------------------------------------------------------
# The grounder (internal/tool/ground) validates every LLM-emitted evidence
# item at emit_evidence.Execute time: Tier 1 checks the read_file gutter
# at source:line for the anchor_symbol token; Tier 2 consults the repomap
# symbol table (definition / call / import). Recovery tiers R1-R5 rewrite
# near-miss LineStart / Source to repair LLM off-by-one mistakes. Items
# that fail every tier are marked ungrounded and routed to the
# "Unverified Leads" section (not citable but visible).
#
# emit_investigation_complete then requires
#   (grounded + recovered) / total >= evidence_grounding_floor
# before accepting the completion signal. A miss returns a rejection
# listing every ungrounded item with concrete repair options so the LLM
# can fix on the next turn without a stage round-trip.

# Minimum grounded ratio required by emit_investigation_complete.
# Range [0, 1]. 0 disables the gate entirely; 1 requires every item grounded.
# Default 0.5 — high enough to block a mostly-speculative investigation,
# low enough that a handful of leads do not deadlock the pipeline.
# evidence_grounding_floor: 0.5

# Minimum (Tier-1 proven grounded / total) ratio required by
# emit_investigation_complete. A Tier-1 evidence item is one whose
# anchor was matched against a file the LLM actually read_file'd —
# i.e. the line-text gutter check passed. Range [0, 1]. 0 disables
# (session-7 backward-compat); a positive value blocks "pure recovery"
# investigations where the LLM never read any cited source — the
# finalizer grounder's stricter Tier-2 check would otherwise drop
# every such citation at cite time, leaving the pipeline stuck. The
# Tier-1 floor moves the intercept point upstream. Default 0.3.
# evidence_tier1_floor: 0.3

# ---------------------------------------------------------------------------
# Explorer heuristics (explore_*)
# ---------------------------------------------------------------------------
# Tunable thresholds for the explorer evaluator's mid-loop and
# soft-stop detection branches. Zero = code default.

# --- Mid-loop detection ---
# explore_midloop_min_iteration: 2
# explore_serial_batch_threshold: 2
# explore_serial_streak_threshold: 2
# explore_partial_read_line_threshold: 150
# explore_midloop_enum_coverage: 0.6
# explore_parallel_unread_floor: 2
# explore_enum_midloop_unread_floor: 2

# --- Soft-stop detection ---
# explore_softstop_enum_coverage: 0.8
# explore_phase0_min_discovered_files: 3
# explore_phase0_max_broaden_attempts: 2
# explore_symbol_min_len_method: 3
# explore_symbol_min_len_other: 8
# explore_max_prescanned_pushes: 3
# explore_erm_suggest_limit: 3

# --- Display ---
# explore_cv_preview_max_len: 1500

# --- Sourcemix budget ---
# explore_per_tool_default_cap: 0

# ---------------------------------------------------------------------------
# CGEC — Citation-Grounded Evidence Closure (cgec_*)
# ---------------------------------------------------------------------------
# CGEC is the cross-stage closure tracker that enforces four
# invariants between the chain producer, the citation grounder, the
# completion gate, and the convergence detector. The defaults below
# are the values the unit + e2e tests pin against.
#
# I1 (chain promotion) and I2 (grounder repair) have no per-deployment
# knobs — they are always on. I3 (pre-complete check) is also always
# on. Only I4 (Lazy Auto-Read + convergence detector) is tunable.

# Maximum files the framework reads on the LLM's behalf per explore
# round when chain-promotion / grounder-rejected files queue up as
# PendingReads. Default 3. Setting 0 DISABLES Lazy Auto-Read entirely
# (the LLM is on its own — mirrors analysis_max_prescan_rounds:0
# disable semantics); setting too high can break ReAct autonomy.
# Negative values are ignored (treated as operator error).
# cgec_forced_reads_per_round: 3

# Convergence detector soft threshold. After this many consecutive
# explore rounds with identical (ReadSet, Evidence, ChainTerm,
# CitedRefs) 4-dim fingerprints, the orchestrator triggers Lazy
# Auto-Read to try to break the stall AND emits a RepairExpandSearch
# directive. Default 2. Setting 0 DISABLES soft-stall detection
# entirely (no Lazy Auto-Read, no RepairExpandSearch from the stall
# path). Negative values ignored.
# cgec_stall_threshold_soft: 2

# Convergence detector hard threshold. After this many consecutive
# identical fingerprints AND no force-read fired, the orchestrator
# emits RepairForceCompleteDowngrade + SetInvestigationComplete so
# the finalizer can ship a best-effort answer instead of looping
# until budget exhaustion. Default 3 (must be >= cgec_stall_threshold_soft).
# Setting 0 DISABLES hard stall (operator who wants observability
# via Stats but NO force-complete sets hard=0). Negative values
# ignored.
# cgec_stall_threshold_hard: 3

# Phase1-unread pre-complete gate. When the LLM calls
# emit_investigation_complete and the explorer's keyword-search top-K
# ranked files still have >= min_unread entries missing from ReadSet
# AND the declared RequirementKind is a breadth-intent question, the
# gate downgrades the call and forces a follow-up read round. The
# downgrade message names every unread top-K file by path so the LLM
# knows exactly what to read next. Set top_k to 0 to disable the gate
# entirely (the LLM is on its own). Default top_k=5, min_unread=2.
# cgec_phase1_unread_top_k: 5
# cgec_phase1_unread_min_unread: 2

# Multi-path coverage parity floor. Per-file ratio
# (read_lines / total_lines) each primary anchor must reach for
# emit_investigation_complete to honour completion when the question
# has ≥ 2 primary anchors. Default 0.3.
#
# Pre-2026-04-29 this was a hard-coded constant 0.3 applied as
# max_anchor_lines × 0.30 across files — a 113-line file fully
# read failed parity against a 683-line sibling at coverage=400
# (gate demanded 120 lines from the 113-line file → impossible).
# The fix made the gate per-file (HasFullyRead bypass + per-file
# CoverageRatio) and yaml-tunable. Lower the floor (0.2) for
# orientation-style deployments; raise (0.5) for thoroughness audits.
# Set to 0 to disable the gate entirely.
# cgec_multi_path_coverage_parity_floor: 0.3

# ---------------------------------------------------------------------------
# Agent limits (agent_*)
# ---------------------------------------------------------------------------
# Per-agent behavioral limits: iteration caps, tool-history budget,
# LoopPolicy defaults, correction retries, investigation_complete policy.

# ReAct loop ceiling for all agents. Default 20. When the loop hits
# this ceiling while the LLM is still tool-calling, the dispatch is
# hard-cut — Fallback S1 only rescues soft-stops, not ceiling cuts.
# Multi-topic scaling in orchestrator.go adds SubTopicExplorerBudgetExtra
# × subTopics on top, capped at 35; single-topic questions get no
# scaling, so lowering this trades iteration headroom for wall time.
# agent_max_iterations: 20

# Cumulative byte budget for "tool" role messages before pruning.
# agent_max_tool_history_bytes: 153600

# Fraction form of agent_max_tool_history_bytes. When set AND
# providers.yaml declares context_window, effective bytes =
# context_window × fraction × 4 (B/token). Same precedence rule
# as blob_max_inline_fraction (fraction > absolute > code default).
# Tool-history is the second-largest share of an iteration's prompt
# (after the user message) so making it model-aware is the largest
# single portability win: 0.3 on a 200K-window model → 240 KB tool
# history; same 0.3 on an 8K-window model → 9.6 KB.
# agent_max_tool_history_fraction: 0.3

# Context-pressure watchdog thresholds. BaseAgent estimates each
# iteration's cumulative prompt bytes and compares against
# (context_window × 4 B/token). Soft logs a warning so the operator
# sees the approach; hard force-stops the ReAct loop at the next
# iteration and injects an agent-specific hint (rendered via
# internal/analysis/hint.Composer) naming ONLY the terminal tool(s)
# the current agent can actually call. Both zero disables just that
# side (set both to 0 to fully skip pressure tracking). Watchdog
# activates only when the adapter reports a positive context_window.
# agent_context_pressure_soft_ratio: 0.7
# agent_context_pressure_hard_ratio: 0.9

# LoopPolicy: minimum iterations between two accepted hint injections.
# agent_loop_min_inject_interval: 3

# LoopPolicy: max soft-stop continuation hints per dispatch.
# agent_loop_max_continuations: 5

# LoopPolicy: max mid-loop hint injections per dispatch.
# agent_loop_max_midloop_injects: 6

# LoopPolicy: consecutive idle iterations before force-stop.
# agent_loop_idle_stop_threshold: 2

# Finalizer: max correction retries when emit_answer_document is missing.
# agent_finalizer_max_correction_retries: 3

# Finalizer shrinkage salvage: when the model first writes a rich prose
# answer outside the tool call, then on the correction retry emits a
# compressed paraphrase as `summary`, ParseOutput replaces the shrunken
# summary with the richer prior draft. Scoped to shape=explanation only.
#
# Master switch. Default true. Set to false to disable the salvage
# entirely (the retry's shorter summary is rendered as-is).
# agent_finalizer_preserve_prior_prose: true

# Minimum bytes the prior prose draft must have to qualify for salvage.
# Shorter drafts are treated as placeholder content, not a real answer.
# Default 400.
# agent_finalizer_shrinkage_min_prose_len: 400

# Ratio threshold len(summary)/len(prior) below which the summary is
# considered "shrunken" and the prior draft is copied in. Default 0.5.
# agent_finalizer_shrinkage_ratio: 0.5

# Extractor: max correction retries when emit_answer_symbol is missing.
# agent_extractor_max_correction_retries: 1

# --- Multi-topic adaptive budget scaling ---
# When RequestModel.SubTopics has >1 entries, these knobs control how
# much extra budget each sub-topic adds. All values have sensible
# defaults; zero-config works out of the box.

# Extra prescan rounds per 2 sub-topics. Adjusted prescan is capped at base+2 (max 4).
# agent_subtopic_prescan_extra: 1

# Extra explorer iterations per sub-topic. Adjusted MaxIterations capped at 35.
# agent_subtopic_explorer_extra: 3

# Extra planner soft-cap iterations per sub-topic (write mode --mode=plan).
# Default 3. Adjusted soft cap is hard-capped at 20 (planner is single-emit).
# Per-dispatch override via AgentContext.MaxIterOverride; consumed by
# plannerEvaluator.BuildInitialInstruction.
# agent_subtopic_planner_extra: 3

# Per-complexity-level uplift to the planner soft cap. Multiplied by
# the analyzer's Complexity classification: Simple = 0×, Moderate = 1×,
# Complex = 2×. Default 2 → Moderate adds +2, Complex adds +4. Stacks
# with agent_subtopic_planner_extra.
# agent_planner_complexity_extra: 2

# Extra pipeline steps per sub-topic. Adjusted step budget capped at 100.
# agent_subtopic_pipeline_extra: 5

# Extra retry budget per 2 sub-topics. Adjusted retry budget capped at
# agent_max_retry_budget_ceil. Consumed by orchestrator.dynamicAnalyzeRetries
# at runAnalyzePhase entry: base + (EstimateSubTopicCount/2) * extra.
# agent_subtopic_retry_extra: 1

# Extra extractor soft-cap iterations per sub-topic. Required for
# multi-topic explanation answers that emit one Key-Anchor row per
# sub-topic; static ExtractorSoftIterCap=3 starves at 4+ sub-topics.
# Hard-capped at agent_extractor_scaled_iter_max (default 8).
# agent_subtopic_extractor_extra: 1

# Per-complexity-level uplift to the extractor soft cap. Multiplied by
# the analyzer's Complexity classification: Simple = 0×, Moderate = 1×,
# Complex = 2×. Default 1 → Moderate adds +1, Complex adds +2. Stacks
# with agent_subtopic_extractor_extra. Mirrors agent_planner_complexity_extra.
# agent_extractor_complexity_extra: 1

# Extra verifier soft-cap iterations per ChangePlan target path
# (write mode only). Multi-language monorepo plans with N target paths
# may need N runner invocations; static VerifierSoftIterCap=5 cannot
# accommodate that. Hard-capped at agent_verifier_scaled_iter_max (default 12).
# agent_target_paths_verifier_extra: 1

# --- Per-evaluator iteration caps (soft / hard pair) ---
# Two-stage cap: at the soft cap continue ONLY when the LLM is
# currently calling the agent's structured emit tool (recovery window
# for streaming truncation); at the hard cap stop unconditionally.
# All zero (the absent-YAML state) inherits the code defaults below.
# Per-dispatch overrides via AgentContext.{Planner,Extractor,Verifier}
# SoftIterCapOverride supersede these for a single dispatch.

# agent_planner_soft_iter_cap: 6
# agent_planner_hard_iter_cap: 9
# agent_extractor_soft_iter_cap: 3
# agent_extractor_hard_iter_cap: 5
# agent_verifier_soft_iter_cap: 5
# agent_verifier_hard_iter_cap: 8
# agent_coder_soft_iter_slack: 3        # soft = len(plan.TargetPaths) + slack
# agent_coder_hard_iter_recovery: 3     # hard = soft + recovery

# --- Absolute ceilings for per-dispatch scaling ---
# Each ceiling caps the result of (base + sub-topic uplift + complexity
# uplift). Zero falls back to the historical hardcoded literal so
# existing yaml continues to behave identically.

# agent_prescan_rounds_ceil: 4              # was hardcoded 4
# agent_explorer_scaled_iter_max: 35        # was hardcoded 35
# agent_planner_scaled_iter_max: 20         # was const plannerScaledIterMax
# agent_extractor_scaled_iter_max: 8        # new — see agent_subtopic_extractor_extra
# agent_verifier_scaled_iter_max: 12        # new — see agent_target_paths_verifier_extra
# agent_max_retry_budget_ceil: 5            # cap for dynamicAnalyzeRetries

# --- Triager outer-loop iteration caps ---
# Hard outer-loop cap on the log_triager / perf_triager agents. Both
# are single-emit (one emit_log_triage / emit_perf_trace terminates
# the ReAct loop); the cap only matters when a misbehaving LLM never
# calls the emit tool — in that case it prevents unbounded token spend.
# Zero or unset falls back to 6 (the historical hardcoded literal).
# agent_log_triager_iter_cap: 6
# agent_perf_triager_iter_cap: 6

# How the DAG scheduler treats explore nodes when emit_investigation_complete
# was called but SuccessCriteria (e.g. evidence_count>=3) still fail:
#   "soft"     — lower evidence_count threshold to >=1 (default)
#   "override" — skip criteria entirely, mark all explore nodes done.
#                SIDE EFFECT: CGEC preCompleteContractCheck also skips
#                all 6 checks (a-f) — the DAG scheduler's "bypass
#                criteria" directive implies the pre-complete gates
#                should also be bypassed to stay consistent. Downgrade
#                messages, RepairExpandSearch / RepairSwapShape /
#                RepairRebindSubject from pre-complete all suppressed.
#   "strict"   — ignore the signal, enforce template thresholds
# agent_investigation_complete_policy: soft

# How the REPL-assembled "Prior conversation" block is surfaced to the
# 4 pipeline stages. The REPL always stores and retrieves prior turns;
# this knob gates VISIBILITY, not persistence, so flipping the policy
# takes effect on the next dispatch without any data migration.
#   "always"   — every stage sees Prior. Historical behaviour;
#                preserved as the opt-out for continuity-sensitive
#                debugging sessions.
#   "analyzer" — (default) only the analyzer sees Prior, where it is
#                useful for entity disambiguation ("它 = last turn's
#                subject"). Explorer / extractor / finalizer stay blind
#                so they cannot copy a prior-turn wrong answer verbatim.
#                AnalysisIR.RequestModel.Entities carries any
#                disambiguated identifiers downstream.
#   "continue" — analyzer always; explorer / extractor / finalizer see
#                Prior only when the current request is a continuation
#                (leading "再/继续/more on/..." or bare-pronoun head).
#   "never"    — no stage sees Prior. Extreme isolation, not
#                recommended outside stress tests.
# agent_prior_conversation_policy: analyzer

# ---------------------------------------------------------------------------
# Summary length caps (summary_cap_*)
# ---------------------------------------------------------------------------
# emit_answer_document can enforce per-shape ceilings on the `summary`
# field. Length control is a MASTER-SWITCHED feature: the default is
# OFF, so the finalizer's emitted summary is accepted as-is and the
# shrinkage-salvage trimmer never trims. Flip summary_cap_enabled:true
# to activate the per-shape numbers below.
#
# When enabled, scalar shapes (explanation / value / config_value /
# boolean) carry fixed ceilings; step_list and list_of_symbols scale
# with the number of items so a long list is not compressed to the
# same budget as a short one:
#
#   step_list        cap = min(step_list_max,  step_list_base  + n * step_list_per_item)
#   list_of_symbols  cap = min(symbols_max,    symbols_base    + n * symbols_per_item)
#
# The caps are read from types.SummaryCapConfig at runtime; codrax.yaml
# overrides here take effect at process start. Every key is optional —
# omitted keys fall through to the code default.

# Master switch. Default false — no length enforcement runs anywhere
# and the numeric knobs below are inert. Set to true to activate
# per-shape caps.
# summary_cap_enabled: false

# Explanation shape: summary IS the answer body (thorough multi-paragraph
# prose with code-level specifics + cross-file relationships). Default 2500.
# summary_cap_explanation: 2500

# Value / ConfigValue shapes: summary is a 1-sentence lead-in before a
# scalar literal. Default 500.
# summary_cap_value: 500
# summary_cap_config_value: 500

# Boolean shape: summary is a lead-in before YES/NO + rationale. Default 800.
# summary_cap_boolean: 800

# StepList shape: base + per-step slope, capped at max. Defaults produce
# 1000 (0 steps) → 1240 (2 steps) → 2200 (10 steps) → 2500 (≥13 steps).
# summary_cap_step_list_base: 1000
# summary_cap_step_list_per_item: 120
# summary_cap_step_list_max: 2500

# ListOfSymbols shape: same shape of scaling as step_list, slightly
# shallower per-item slope because the symbols carry most content.
# Defaults: 1000 → 1200 (2 symbols) → 2000 (10 symbols) → 2500 (≥15).
# summary_cap_symbols_base: 1000
# summary_cap_symbols_per_item: 100
# summary_cap_symbols_max: 2500

# Fallback cap for any shape not covered above. Default 500.
# summary_cap_default: 500

# ---------------------------------------------------------------------------
# Citation quote preview ceiling (citation_quote_max_chars)
# ---------------------------------------------------------------------------
# Every emit_answer_document citation may carry an optional verbatim
# Quote of the source line. Oversize Quotes are truncated on a UTF-8
# boundary before being stored — file+line anchors are always preserved,
# and the grounder's token-match still clears prose-smuggled Quotes
# regardless of length, so this cap is purely the rendered preview
# width, not a correctness gate.
#
# Raise this for codebases with routinely long source lines (Kotlin
# DSLs, Scala implicits, deep package imports, multi-arg fmt.Errorf,
# long SQL / regex literals). Non-positive values are ignored.
# Default: 500.
# citation_quote_max_chars: 500

# ---------------------------------------------------------------------------
# Chit-chat REPL command (chitchat_enabled)
# ---------------------------------------------------------------------------
# The REPL recognises `/chat <message>` as a casual conversation slash
# command that bypasses the analysis pipeline: a single LLM Chat call
# replies to the user without running analyze → explore → extract →
# finalize. Useful for greetings, tool-capability questions, and any
# turn that does not need repository access.
#
# The feature is a user-triggered slash command, so simply making it
# available imposes zero cost on users who never type /chat. Single-
# shot (--request) mode never touches this path regardless of the
# setting. Set to false to make /chat print a "not configured" warning
# (e.g. restricted deployments where no chat companion is desired).
#
# Provider routing: operators can route the chit-chat responder to a
# cheap model via providers.yaml:
#
#   llm:
#     agents:
#       chitchat_responder:
#         model: gpt-4o-mini
#         think_aloud: false
#
# Falls back to llm.default when no agent-specific entry exists.
#
# Default: true.
# chitchat_enabled: true

# Optional auto-classifier. When enabled, the REPL runs one LLM call
# before every normal dispatch to decide whether the turn should go to
# the chit-chat responder (bypassing the pipeline) without requiring
# the user to prefix /chat. Fail-safe: any classifier error routes the
# turn to the pipeline unchanged.
#
# Requires chitchat_enabled: true. Skipped when a runtime log is
# attached (sticky /log or auto-routed paste) because a log is strong
# evidence of a code question. Adds one cheap LLM call per turn, so
# route to a small model via providers.yaml:
#
#   llm:
#     agents:
#       chitchat_classifier:
#         model: gpt-4o-mini
#         think_aloud: false
#
# Default: true. Adds one cheap LLM call per REPL turn; fail-safe so
# any classifier error routes the turn to the pipeline unchanged. To
# keep the cost small, route the classifier to a small model via
# providers.yaml agents.chitchat_classifier (see example above). To
# disable entirely, set this to false.
#
# Per-run override: the --chitchat-classifier CLI flag takes
# precedence over this yaml value for one codrax invocation. Use it
# to toggle the classifier on/off while debugging without editing
# yaml. `--chitchat-classifier` / `--chitchat-classifier=true` →
# force on; `--chitchat-classifier=false` → force off; flag omitted
# → this yaml value wins.
# chitchat_classifier_enabled: true

# Chit-chat tool-use limits. The /chat path now runs a bounded
# 2-round ReAct loop with the recall_memory tool when memory is
# wired: round 1 the LLM may call recall_memory to look up prior
# conversation, round 2 it synthesises the user-visible reply.
# These two knobs clamp the LLM's `limit` argument to recall_memory
# so a chatty LLM cannot drown the second-round Chat call's token
# budget. Smaller than the explorer's hard cap (20) because chitchat
# is one-shot conversation, not iterative investigation. Skipped
# silently when memory is unwired (single-shot CLI).

# Default `limit` applied when the LLM calls recall_memory without
# specifying one. Tracks the explorer-side default to keep behaviour
# predictable across paths.
# chitchat_recall_default_limit: 5

# Hard ceiling on the `limit` arg — values above this are clamped
# before the search runs.
# chitchat_recall_max_limit: 10

# list_memory tool — browse-mode listing (no relevance scoring,
# returns the most-recent N entries). Default and hard-cap caps
# track the recall_* pair; list mode usually surfaces fewer
# per-entry tokens so the cap can be slightly larger.
# chitchat_list_default_limit: 10
# chitchat_list_max_limit: 30

# ---------------------------------------------------------------------------
# Environment recommendation pipeline (env_recommend_*)
# ---------------------------------------------------------------------------
# When a runner / build / test step fails because of a missing
# binary, dependency, system library, or git-state issue, codrax
# runs a deterministic Layer 1-3 pipeline (probe → diagnose →
# recommend) that surfaces precise, environment-aware install
# commands in the failure message. Commands are prefixed with `!`
# so they can be copy-pasted directly into the codrax prompt.
#
# Architecture:
#   Layer 1 — probe: scans OS / shell / package managers / project
#             manifests / Python interpreters / Node / Rust / Java /
#             Ruby toolchains + git repo state. ~400ms once per Run.
#   Layer 2 — diagnose: structured Diagnosis from stderr + EnvFacts
#             across 8 DiagKinds (runner_missing, deps_missing,
#             toolchain_missing, system_lib_missing, config_missing,
#             git_not_installed, git_not_initialized, git_no_commits)
#             plus Unknown sentinel for LLM fallback.
#   Layer 3 — recommend: per-runner table → disk cache → LLM fallback
#             → DocsLink. Returns up to 3 ranked install candidates
#             with InstallStrategy (venv/project/user/toolchain/
#             global/docs) priority.
#
# Master switch. false → fall back to legacy hardcoded
# runnerInstallHint strings (byte-identical with pre-feature behaviour).
# env_recommend_enabled: true

# Stage 3 LLM fallback for Diagnosis=Unknown / niche package-name
# translation. false → only deterministic table is consulted.
# env_recommend_llm_enabled: true

# LLM call timeout. Hitting this drops to deterministic-only.
# env_recommend_llm_timeout_sec: 5

# Whether the Recommender produces sudo / global-install commands
# (apt/dnf/brew install, npm install -g, sudo gem install). Default
# false — operator must opt in. When false, GlobalInstall candidates
# are silently filtered before render.
# recommend_global_install: false

# Whether the probe layer attempts a network reachability check
# (TCP connect to 1.1.1.1:443). Disabling saves ~200ms startup.
# env_probe_network: true

# TTL for cached LLM-derived recommendations stored at
# ~/.codrax/cache/env-cache.json. Default 90 days; package name
# mappings stay stable in this window.
# env_cache_ttl_days: 90

# ---------------------------------------------------------------------------
# Memory store limits (memory_*)
# ---------------------------------------------------------------------------
# Multi-turn REPL memory: buffer sizes and context-building caps.
#
# Memory compaction (summarizing oldest recent turns into MEMORY.md
# index entries) calls the LLM once per compaction. The call uses a
# structured tool schema — LLM emits a single emit_memory_summary
# tool call with {topic, keywords, summary} — so parsing can never
# fail silently on prose-wrapped JSON. All failure paths (no tool
# call, malformed JSON, chat error, nil adapter) fall back to a
# heuristic IndexEntry built from the turn's request/response, so
# compaction cannot break the REPL.
#
# Operators who want to route memory compaction to a cheap model
# (without changing the main pipeline model) add an agent entry to
# providers.yaml:
#
#   llm:
#     agents:
#       memory_summarizer:
#         model: gpt-4o-mini
#         think_aloud: false
#
# No codrax.yaml knob is needed — presence of the agent key is the
# opt-in. Absent that key, the summarizer reuses llm.default.

# Number of recent turns kept verbatim before LLM-summarization.
# memory_max_recent_turns: 6

# Total byte budget for the recent turn buffer.
# memory_max_recent_bytes: 20480

# Max size of a single turn's request+response stored to disk.
# REPL paste-folding keeps request bodies compact; raise only if
# scripted input legitimately needs larger turn bodies.
# memory_max_turn_body_bytes: 16384

# Max compacted index entries whose Summary is inlined into
# BuildContext per request. Full turn text is never inlined — only
# the LLM-generated one-line summary.
# memory_max_build_context_matches: 3

# ---------------------------------------------------------------------------
# Memory retrieval scoring (memory_entity_min_runes / _session_tie_breaker_bonus)
# ---------------------------------------------------------------------------
# Two scoreIndex-level magic numbers that previously lived inline in
# internal/memory/store.go. Defaults preserve pre-refactor behaviour
# byte-for-byte; touch only if the index is over- or under-firing
# in your traces.

# Minimum Unicode-rune length an entity surface must have to participate
# in the entity-substring check. Below this, generic short tokens
# ("id", "go", "rpc") would over-fire and surface irrelevant entries.
# Raise to 4 or 5 if your codebase uses long identifier conventions
# and you see noise hits.
# memory_entity_min_runes: 3

# Extra score added to a candidate IndexEntry whose SessionID matches
# the current REPL session AND already has positive relevance. Bare
# session membership is intentionally NOT enough to surface an
# irrelevant entry — this only orders ties between equally-relevant
# cross-session matches. Raise to 2-3 to bias more strongly toward
# the live thread when answering follow-ups.
# memory_session_tie_breaker_bonus: 1

# Hard caps on Store.Search and Store.List `limit` opts. Search is the
# relevance-ranked path used by the explorer's recall_memory and the
# chitchat responder's recall tool; List is the browse-mode path used
# by chitchat list_memory. Defaults match the historical hardcoded
# literals (20 / 30); raise only if BuildContext's byte budget can
# clearly absorb the extra matches without hurting downstream prompts.
# memory_search_max_limit: 20
# memory_list_max_limit: 30

# ---------------------------------------------------------------------------
# Per-Kind retrieval policy (memory_policy_*)
# ---------------------------------------------------------------------------
# Each turn carries a Kind label — chitchat / shell / pipeline / plan /
# (legacy default for unknown). BuildContext applies a per-Kind tuning
# when assembling the prior-conversation block:
#
#   session_pin_count   — how many same-session recent turns to keep
#                         unconditionally regardless of keyword match.
#   recent_body_chars   — rune cap for inlining session-pinned turn
#                         bodies (0 = use the legacy ~200-char one-line
#                         collapse).
#   compacted_match_cap — top-K cap on matched compacted index entries
#                         (-1 = use memory_max_build_context_matches).
#   entity_score_mul    — multiplier on entity-substring hits vs
#                         keyword hits in scoreIndex.
#   refs_chain_depth    — how many hops of IndexEntry.Refs to follow
#                         after the primary match list is picked.
#
# Defaults preserve the pre-refactor hardcoded values:
#
#   chitchat / shell : {3, 1200, 3, 2, 1}
#   pipeline         : {2,    0, 5, 3, 2}
#   plan / default   : {0,    0, -1, 2, 0}
#
# Field-level merge: omit a sub-policy entirely (or leave a field at 0)
# to keep the corresponding default. The example below tightens
# pipeline retrieval (more compacted matches, deeper refs chain) without
# touching chitchat:
#
# memory_policy_pipeline:
#   compacted_match_cap: 8
#   refs_chain_depth: 3
#
# Full surface for completeness:
# memory_policy_chitchat:
#   session_pin_count: 3
#   recent_body_chars: 1200
#   compacted_match_cap: 3
#   entity_score_mul: 2
#   refs_chain_depth: 1
# memory_policy_shell: {…}
# memory_policy_pipeline: {…}
# memory_policy_plan: {…}
# memory_policy_default: {…}

# ---------------------------------------------------------------------------
# Log-triage (log_triage_*)
# ---------------------------------------------------------------------------
# When the user attaches a runtime log excerpt via --log / --log-text /
# REPL /log, a conditional pre-stage (the log_triager agent) runs an
# LLM-driven extractor that emits a structured LogBundle (errors +
# frames + signals + residue). The system validates paths against the
# repository and derives the resolved-file list. The analyzer then
# reads the bundle to seed AnalyzerHints.Entities and
# EvidencePlan.RequiredFiles.
#
# Generalization note: unlike session 19's regex-per-format approach,
# the LLM extractor handles Rust / Ruby / custom application JSON
# logs / compiler output uniformly with zero parser-per-format code.
# The system guards against hallucinations via os.Stat path
# verification and runtime-internal filters.

# Global feature gate. When false, the log_triager agent's Guard
# returns false regardless of AttachedLog and the pre-stage is skipped
# entirely. The --log flag still reads the file but the payload is
# not extracted. Default true.
# log_triage_enabled: true

# User-provided build-path prefix for stack-frame files from CI /
# build machines. C/C++ traces commonly carry absolute paths like
# `/build/src/...` or `/home/jenkins/workspace/.../src/...` that the
# built-in cascading stripper can miss. Tried FIRST before the
# built-in CI root list. Mirrored by the CLI flag
# --log-source-prefix — when both are set the CLI flag wins.
# log_triage_source_prefix: ""

# Minimum log size (bytes) below which the pre-stage is skipped.
# Very short logs (a single error line) rarely contain extractable
# frames; the LLM call cost outweighs the benefit. Default 50.
# log_triage_min_bytes: 50

# Fail-loud retry budget for emit_log_triage schema rejections.
# 0 = never retry (degrade to nil bundle). Default 1.
# log_triage_max_retries: 1

# Two-step fallback master switch. When false, oversized / low-coverage
# logs take the single-shot result (or nil on failure) without
# attempting segmentation. Default true.
# log_triage_two_step_enabled: true

# Byte threshold above which the pre-stage goes straight to two-step
# (bypasses single-shot). Conservative default so single-shot handles
# the common short-panic case; only polyglot / multi-cycle / k8s
# aggregated logs pay the segmentation cost. Default 32768 (32 KB).
# log_triage_two_step_bytes: 32768

# Coverage threshold below which a single-shot bundle escalates to
# two-step. Coverage = 1 - bytes(unknown_chunks) / bytes(rawLog).
# Default 0.3 (under 30% structured → escalate).
# log_triage_two_step_coverage: 0.3

# Hard cap on total LLM invocations for one pre-stage Run (covers
# 1 single-shot + 1 segmentation + N per-segment extractions).
# Defence against runaway segmentation. Default 12, sized so that
# the full 10-segment cap of emit_log_segmentation can flow through
# per-segment extraction (1 + 1 + 10 = 12). For very large captures
# (50 MB+ hdc / adb dumps) raise to 16-20 if you want more head-
# room past the segmenter cap; sizes below 8 will silently drop
# segments because perSegBudget = max - 2.
# log_triage_max_llm_calls: 12

# ---------------------------------------------------------------------------
# Perf-triage knobs (perf_triage_*)
# ---------------------------------------------------------------------------
# Controls the perf_triage pre-stage that fires when --htrace /
# --htrace-text / REPL /htrace attaches a HiTrace / atrace / systrace /
# perfetto text excerpt. Mirrors log_triage_* exactly so the same
# operator mental model transfers; defaults are tuned for typical
# HarmonyOS hdc + Android adb capture volumes.

# Master toggle. false → perf_triage stage skipped entirely; the
# attached trace passes through to other consumers untouched.
# Default true.
# perf_triage_enabled: true

# Minimum trace size before the stage fires. Below this the cost
# of an LLM round-trip outweighs what perf_triager could extract.
# Default 200 bytes.
# perf_triage_min_bytes: 200

# Fail-loud retry budget when emit_perf_trace rejects (schema or
# cross-field). 0 = never retry. Default 1.
# perf_triage_max_retries: 1

# Toggle the two-step fallback (emit_perf_segmentation → per-segment
# emit_perf_trace → MergePerfBundles). false forces single-shot only.
# Default true.
# perf_triage_two_step_enabled: true

# Straight-to-two-step byte threshold. Traces ≥ this size skip the
# single-shot attempt and go directly to segmentation. 64 KB matches
# the typical multi-PID hdc/adb capture size; smaller values pay an
# extra LLM call on traces single-shot would have handled fine.
# Default 65536 (64 KiB).
# perf_triage_two_step_bytes: 65536

# Single-shot coverage threshold. When single-shot returns a bundle
# with Coverage below this float, the controller escalates to two-
# step. Default 0.3.
# perf_triage_two_step_coverage: 0.3

# Hard cap on total LLM invocations for one perf_triage pre-stage
# Run (covers 1 single-shot + 1 segmentation + N per-segment
# extractions). emit_perf_segmentation caps at 10 segments, so 12
# = 1 + 1 + 10 covers the full budget. Default 12.
# perf_triage_max_llm_calls: 12

# ---------------------------------------------------------------------------
# Log attach cap (log_attach_*)
# ---------------------------------------------------------------------------
# Hard ceiling on the byte length of any attached log, applied BEFORE
# log_triage sees the payload. Covers every attach surface:
#   - CLI: --log <file>, --log -, --log-text <inline>
#   - REPL: /log <path>, /log paste mode, splitPastedLog auto-route
# Stdin (`--log -`) uses io.LimitReader(N+1) so the process never
# buffers more than N+1 bytes even when a multi-GB pipe is upstream.
# Files and inline text truncate to the first N bytes with a WARN
# log line; the tail (often the actual error frames) is lost, so
# pre-filter with grep before attaching multi-day dumps.
#
# Applies to BOTH --log / /log AND --htrace / /htrace, each independently.
# Fires even when log_triage_enabled=false — this knob is about
# memory safety, not triage quality. Raising it lets you attach
# bigger logs but multiplies downstream LLM token cost linearly
# (every byte past the first 32 KB two-step threshold also drives
# more per-segment extraction calls up to log_triage_max_llm_calls).
#
# Non-positive values (incl. explicit 0) fall back to the default
# rather than degrading to zero-byte truncation, which would
# silently break every /log surface.
#
# Default 52428800 (50 MiB) — matches typical HarmonyOS / Android
# capture volumes (hdc shell hilog / hitrace, adb logcat -d /
# atrace). Hard ceiling 1 GiB enforced by codrax to prevent OOM.
# Workstations with abundant RAM can go higher, e.g.
#   log_attach_max_bytes: 209715200   # 200 MiB
# but be aware: every byte still passes through truncateAttachedLog
# in memory, and oversized attachments push the LLM into many
# per-segment two-step calls (capped by log_triage_max_llm_calls).
# Pre-filter long captures with grep / awk before attaching when you
# can.
# log_attach_max_bytes: 52428800

# Perf-channel cap. Bounds --htrace / --atrace / --htrace-text /
# --atrace-text and the REPL /htrace + /atrace surfaces. When unset
# (the recommended default), inherits whatever log_attach_max_bytes
# resolves to, so a single yaml knob configures both channels
# symmetrically. Set explicitly to break the symmetry — e.g. to
# allow larger HiTrace bodies than logs:
#   trace_attach_max_bytes: 209715200   # 200 MiB
# Same 1 GiB hard ceiling applies.
# trace_attach_max_bytes: 52428800

# ---------------------------------------------------------------------------
# REPL interactive (repl_*)
# ---------------------------------------------------------------------------
# Runtime tweaks for the interactive prompt. Single knob today.

# Pastes with >= this many runes (Unicode characters, not bytes) fold
# to a `[Pasted text #N …]` placeholder visible in the input area;
# the original body is expanded back at submit time so the LLM sees
# the full text. Multi-line pastes fold unconditionally regardless
# of length. Default 120 (~2 visual lines on typical widths). Set
# 0 (or omit) to inherit the default.
# repl_paste_fold_min_chars: 120

# ---------------------------------------------------------------------------
# Repomap tier reporting (repomap_*)
# ---------------------------------------------------------------------------
# Per-language fall-through ratios that gate the parse-tier degradation
# banners emitted by the repomap scanner. The scanner logs every
# downgrade individually at WARN level; these knobs gate the aggregate
# per-language summary so operators see emerging extractor maintenance
# needs without scrolling through individual file lines.

# Soft floor — per-language Tier-2+ ratio at which the scanner emits
# an INFO line ("trending toward extractor maintenance"). Picked
# below the alert ratio so operators see emerging degradation BEFORE
# it breaches. 0 inherits the code default (0.30).
# repomap_tier_warn_ratio: 0.30

# Alert ratio — per-language Tier-2+ ratio at which a WARN-level
# "consider extractor / grammar update" banner fires. ArkTS keeps a
# stricter 0.40 and Cangjie a stricter 0.50 internally; this knob
# only changes the threshold for languages without a hardcoded
# override. 0 inherits the code default (0.50).
# repomap_tier_alert_ratio: 0.50

# ---------------------------------------------------------------------------
# Path to providers config
# ---------------------------------------------------------------------------
# Keeping this here means `CODRAX_SETTINGS=envs/prod/codrax.yaml`
# bootstraps an entire environment from a single entry point.

# providers_config: providers.yaml
