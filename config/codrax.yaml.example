# =============================================================================
# codrax runtime settings — copy to config/codrax.yaml to activate.
# =============================================================================
#
# There are three YAML files under config/, each with a distinct role.
# Do not duplicate keys across them:
#
#   orchestrator.yaml — Pipeline topology only: stages, transitions,
#                       task policies, agent/skill bindings.
#
#   providers.yaml    — LLM provider credentials and per-agent model
#                       routing. Per-user secrets, never committed.
#
#   codrax.yaml       — THIS FILE. Per-process runtime knobs: where to
#                       write logs and memory, default response language,
#                       per-invocation targets (repo, branch), global
#                       step budget, tool blob sizing, pipeline
#                       behavior, and pointers to the other two files.
#
# Precedence (lowest wins last):
#
#   code defaults  <  config/codrax.yaml  <  command-line flags
#
# Every key is optional — omitted keys fall through to the code default.
# The binary silently falls back to defaults when this file is missing,
# so checking in an example while leaving the real file out of version
# control is the expected workflow.
#
# To point at a different runtime settings file without editing this
# path, set the CODRAX_SETTINGS environment variable.

# ---------------------------------------------------------------------------
# Log sink
# ---------------------------------------------------------------------------

# Directory for rotating log files. Created on first run.
# log_dir: logs

# Minimum level written to the log file. One of: error, warning, info, debug.
# log_level: info

# Mirror every log record to stdout in addition to the file.
# Useful for foreground debugging; keep off for clean REPL UX.
# log_stdout: false

# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------

# Directory for multi-turn conversation memory (MEMORY.md + turns/).
# memory_dir: memory

# Base directory for repo map caches (symbol index, relations, etc.).
# Each target repo gets its own subdirectory under <cache_dir>/repomap/.
# Default (when omitted): platform cache dir — ~/.cache/codrax (Linux),
# ~/Library/Caches/codrax (macOS), %LocalAppData%\codrax (Windows).
# cache_dir:

# ---------------------------------------------------------------------------
# Response language
# ---------------------------------------------------------------------------

# Default response language for the model's final answer.
# Supported shorthands: zh, zh-CN, en. Any other string is passed
# through verbatim as a preference directive. Set to "off" or "none"
# to disable the feature entirely (model picks its own language).
# lang: zh

# ---------------------------------------------------------------------------
# Per-invocation target
# ---------------------------------------------------------------------------
# These describe WHERE the pipeline runs. Step budgets and per-stage
# limits all live under "Pipeline behavior" below — they share the
# pipeline_* prefix so the budget knobs are visually grouped.

# Target repository the agents operate on.
# repo: .

# Default git branch for the working context.
# branch: main

# ---------------------------------------------------------------------------
# Tool output blob sizing
# ---------------------------------------------------------------------------
# Tool results larger than blob_max_inline_bytes are offloaded to a
# blob file under the work dir; only a head+tail preview is inlined
# into the LLM context. The head/tail split controls how much of the
# original output the model can still see in the preview.
#
# Defaults are tuned for typical Go repositories where most source
# files fit comfortably in 32 KB. Lower the threshold if you are
# working with a token-budget-constrained model and want more
# aggressive truncation; raise it (and grow the head budget to match)
# if you are routinely dealing with files in the 30-60 KB range.

# blob_max_inline_bytes: 32768
# blob_preview_head_bytes: 24576
# blob_preview_tail_bytes: 4096

# ---------------------------------------------------------------------------
# Pipeline behavior
# ---------------------------------------------------------------------------
# Runtime operator knobs (retry budgets, behavior toggles, step budget).
# Pipeline topology (stages, transitions, policies) lives in
# orchestrator.yaml; these keys control *how* the pipeline runs.
#
# Precedence (lowest wins last):
#   code default
#     → these keys
#     → command-line flags (-pipeline-max-steps, -pipeline-max-retries,
#       -pipeline-max-stage-visits have CLI overrides; the three
#       boolean toggles are CLI-less).

# Maximum total pipeline steps per Run() call. Acts as a hard global
# budget cap independent of per-stage retries and oscillation guards.
# pipeline_max_steps: 50

# Enable / disable the verify stage globally.
# pipeline_enable_verify: true

# When true, use the high_risk_implementation policy that includes
# design_review and code_review stages.
# pipeline_require_review: true

# Max consecutive failures per stage before forcing finalize.
# pipeline_max_retries_per_stage: 3

# Oscillation guard: cap per-stage entries per Run before forced
# finalize. Values <= 0 fall back to the code default (4).
# pipeline_max_stage_visits: 4

# When true, small changes can jump from explore to implement,
# skipping plan.
# pipeline_allow_skip_plan_for_small_change: false

# ---------------------------------------------------------------------------
# Paths to the other two config files
# ---------------------------------------------------------------------------
# Keeping these here means `CODRAX_SETTINGS=envs/prod/codrax.yaml`
# bootstraps an entire environment from a single entry point.

# orchestrator_config: config/orchestrator.yaml
# providers_config: config/providers.yaml
