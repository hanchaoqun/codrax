# HMC-08.2: endpoint populations, byte provenance and wall-clock rates.
ID="trace_query_io_activity"
NAME="trace query — IO endpoint activity, known byte sizes and wall-clock rates"
# Natural-user version (2026-09-24): measurement correctness belongs to the
# system and independent oracle, not to a checklist in the user's question.
# Earlier runs retain the original request in their logs/reports and git history.
QUESTION="帮我看看这份 trace 在 2.00～2.25 秒的 IO 活动：RQ、BIO、MMC、F2FS 各有多少次发起和完成，数据量和速率怎样？再给出 RQ 的读写次数占比和数据量占比、请求大小分布，以及每 100ms 的变化。"
HTRACE_FILE="eval/fixtures/hmosperf_io_activity/events.systrace"
FIXTURE="eval/fixtures/stub_repo"
N_DEFAULT=1

# Presence-only smoke checks. They do not prove semantic correctness or grant
# runtime authority. Human review must bind all values and populations to
# expected.json and the physical event lines, especially known zero vs unknown.
EXPECT_PRIMARY_CONTAINS="RQ BIO MMC F2FS"
EXPECT_PRIMARY_MATCHES_REGEX="(^|[^0-9])28([.]0+)?([^0-9]|$)
(37,?888|148([.]0+)?|151,?552)
(未知|未提供|不可用|unavailable|unknown)"
EXPECT_LOG_MATCHES_REGEX="phase=toolcall .*tool=trace_query"
