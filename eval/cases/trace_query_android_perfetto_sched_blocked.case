# Trace query external fixture — Android/Perfetto sched blocked reason
#
# Source fixture:
#   https://github.com/google/perfetto/blob/main/test/trace_processor/diff_tests/parser/parsing/sched_blocked_systrace.systrace
# License: Apache-2.0, Google Perfetto project.
#
# Coverage target: real Perfetto systrace rows using `(-----)` TGID plus
# sched_blocked_reason. This locks the Android/generic ftrace path without
# applying Harmony priority semantics.
ID="trace_query_android_perfetto_sched_blocked"
NAME="trace query — Android Perfetto sched_blocked_reason fixture"
QUESTION="这是一段 Android/Perfetto systrace 文本。请分析 pid=2172 在线程 bar 这段 21.058854s 到 21.123839s 之间为什么进入 D 状态，说明是否 iowait，以及 blocked reason/caller 是什么。不要把 trace 行号当源码行号。"
HTRACE='          <idle>-0     (-----) [006] ....    10.258854: sched_switch: prev_comm=swapper/6 prev_pid=0 prev_prio=120 prev_state=D ==> next_comm=foo next_pid=269 next_prio=130
             foo-269   (-----) [006] ....    20.258854: sched_switch: prev_comm=foo prev_pid=269 prev_prio=120 prev_state=D ==> next_comm=swapper/6 next_pid=0 next_prio=130
          <idle>-0     (-----) [006] d..3    20.258855: sched_blocked_reason: pid=269 iowait=0 caller=worker_thread+0x534/0x820
          <idle>-0     (-----) [000] ....    21.058854: sched_switch: prev_comm=swapper/0 prev_pid=0 prev_prio=120 prev_state=D ==> next_comm=foo next_pid=2172 next_prio=130
             bar-269   (-----) [000] ....    21.123838: sched_switch: prev_comm=bar prev_pid=2172 prev_prio=120 prev_state=D ==> next_comm=swapper/0 next_pid=0 next_prio=130
          <idle>-0     (-----) [000] d.s4    21.123839: sched_blocked_reason: pid=2172 iowait=1 caller=__filemap_fdatawait_range+0x134/0x150
'
EXPECT_CONTAINS="__filemap_fdatawait_range iowait"
EXPECT_MATCHES_REGEX="(pid[ =:]*2172|2172).*(D|不可中断|uninterruptible|iowait|I/O)|(__filemap_fdatawait_range|filemap).*(iowait|I/O|等待|wait)"
