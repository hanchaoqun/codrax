# Openai dataflow pipeline validation case
# Format: shell-sourceable. Used by eval/run.sh.
ID="df1"
NAME="openai dataflow validation — sub-agent invoker identity literal"
QUESTION="有多少个agent可以调用subagent?"
# Substrings the answer MUST contain (space-separated, AND).
# Post-Phase-4 the canonically correct answer names the string literal
# returned by SubExplorer.Name() ("explorer"), not the Go class pair
# ("Explorer SubExplorer") the pre-Phase-4 finalizer used to produce —
# SubExplorer is the callee's identity, not a second invoker, so the
# class-name pair was semantically wrong. See
# memory/project_baseline_2026_04_13_post_phase4.md.
EXPECT_CONTAINS="explorer"
# Substrings the answer MUST NOT contain (space-separated, all banned).
EXPECT_NOT_CONTAINS="Orchestrator BaseAgent SubAgentRuntime"
