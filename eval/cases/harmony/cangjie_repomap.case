# Repomap — Cangjie func/extend/foreign enumeration
#
# Exercises PR-0c extract_cangjie. The fixture (PR-0c provides
# eval/fixtures/testdata/cangjie_minimal/) contains the corpus seeds
# from internal/thirdparty/tree-sitter-cangjie/corpus/sources/. The
# question forces analyzer to use repomap to enumerate top-level
# constructs.
#
# PR-0c deliverable: eval/fixtures/testdata/cangjie_minimal/ with
# main.cj + cart/Cart.cj + bridge/Bridge.cj covering func/class/
# struct/extend/foreign.
#
# Ground truth: at least 1 `extend` block + 1 `foreign func`
# declaration + 1 `class` with `public` modifier. Question pins
# these so a vague "Cangjie supports OOP" answer fails.
ID="cangjie_repomap"
NAME="repomap Cangjie extend + foreign func + public class enumeration"
QUESTION="仓库里有哪些 extend 块、哪些 foreign func 声明、哪些 public class？分别列出文件路径和符号名，并指出包路径（package 声明）。"
EXPECT_CONTAINS="extend"
EXPECT_DIMENSIONS="package"
EXPECT_DIMENSION_VALUES_PACKAGE="demo.stringext demo.ffi demo.greeter"
EXPECT_INVENTORY_ROWSETS="extend foreign_func public_class"
EXPECT_INVENTORY_ROW_SCOPE_EXTEND="line"
EXPECT_INVENTORY_COUNT_EXTEND=2
EXPECT_INVENTORY_ROWS_EXTEND=$'extend String|04_extend_operator.cj|demo.stringext\nextend Cart|Cart.cj|demo.cart'
EXPECT_INVENTORY_ROW_SCOPE_FOREIGN_FUNC="line"
EXPECT_INVENTORY_COUNT_FOREIGN_FUNC=2
EXPECT_INVENTORY_ROWS_FOREIGN_FUNC=$'native_add|07_foreign_ffi.cj|demo.ffi\nnative_add|Bridge.cj|demo.bridge'
EXPECT_INVENTORY_BANNED_ROWS_FOREIGN_FUNC=$'foreign func|runOnMainThread|07_foreign_ffi.cj'
EXPECT_INVENTORY_ROW_SCOPE_PUBLIC_CLASS="line"
EXPECT_INVENTORY_COUNT_PUBLIC_CLASS=8
EXPECT_INVENTORY_ROWS_PUBLIC_CLASS=$'App|main.cj|demo.app\nCart|Cart.cj|demo.cart\nBridge|Bridge.cj|demo.bridge\nGreeter|02_class_init_methods.cj|demo.greeter\nAnimal|08_modifiers_combos.cj|demo.modifiers\nDog|08_modifiers_combos.cj|demo.modifiers\nService|08_modifiers_combos.cj|demo.modifiers\nVersion|06_generic_where.cj|demo.generics'
