# Repomap — ArkTS struct + decorators detection
#
# Exercises PR-0 extract_arkts. The fixture (PR-0 will provide
# eval/fixtures/testdata/arkts_minimal/) contains the corpus seeds
# from internal/thirdparty/tree-sitter-arkts/corpus/sources/. The
# question forces the analyzer to use repomap to enumerate
# components and their decorators.
#
# Current fixture uses the in-repo tree-sitter ArkTS corpus under
# internal/thirdparty/tree-sitter-arkts/corpus/sources/. Pin the real
# corpus path instead of the old PR-0 placeholder filename.
#
# Ground truth: at least 2 @Component declarations + 1 @Entry +
# 1 @Builder. Question names them so EXPECT_CONTAINS pins concrete
# symbols rather than vague "ArkTS supports decorators".
ID="arkts_repomap"
NAME="repomap ArkTS @Entry @Component struct + @Builder enumeration"
QUESTION="仓库里有哪些 @Entry 标记的 ArkTS 页面入口，以及哪些 @Builder 复用片段？分别列出文件路径和函数名。"
EXPECT_CONTAINS="@Entry @Component"
EXPECT_SECTIONS="01_entry_component_minimal.ets"
EXPECT_INVENTORY_ROWSETS="entry_page builder_fragment"
EXPECT_INVENTORY_ROW_SCOPE_ENTRY_PAGE="document"
EXPECT_INVENTORY_COUNT_ENTRY_PAGE=4
EXPECT_INVENTORY_ROWS_ENTRY_PAGE=$'Index|01_entry_component_minimal.ets\nParentComponent|03_state_management.ets\nStyledPage|04_styles_extend.ets\nListPage|05_foreach_lazyforeach.ets'
EXPECT_INVENTORY_ROW_SCOPE_BUILDER_FRAGMENT="document"
EXPECT_INVENTORY_COUNT_BUILDER_FRAGMENT=2
EXPECT_INVENTORY_ROWS_BUILDER_FRAGMENT=$'defaultHeader|02_builder_decorator.ets\nGlobalCard|02_builder_decorator.ets'
