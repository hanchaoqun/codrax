# Log triage — explicit relative log path in question
#
# Coverage target: when the user names a log path in the question rather than
# using --log, the system should treat the artifact as the primary input and not
# force current-source status wording.
ID="log_path_question_relative_panic"
NAME="log triage — relative log path mentioned in question"
QUESTION="只分析 eval/fixtures/runtime_path_panic.log 这个日志文件，不分析代码。请说明 panic 类型、关键栈帧和最可能的直接触发点。"
EXPECT_CONTAINS="panic nil"
EXPECT_MATCHES_REGEX="runtime error|nil pointer|空指针
store\\.go:88|\\(\\*Store\\)\\.Get|Store\\.Get
handler\\.go:52|\\(\\*Handler\\)\\.ServeHTTP|ServeHTTP"
EXPECT_NOT_CONTAINS="still_present not_enough_evidence"
