# Hard-gate precision — multi member_set counts in shared caveats
#
# Regression target: when an answer carries several principal
# member_set facts (types / functions / Kind constants),
# count validation must bind visible numbers to an explicit set label,
# not to any member name that happens to appear in shared scope prose.
# The prompt intentionally asks for category counts plus a scope note
# so the answer is allowed to mention multiple numbers near the same
# package members. It deliberately excludes variables so this case stays
# focused on hard-gate precision; language-wide exported API row fidelity
# is tracked separately under the Batch 1 ExportedAPIRow gap.
ID="qf_multi_member_set_count_caveat"
NAME="hard-gate precision — multi member-set count caveat"
QUESTION="internal/analysis/criterion 请只按类型、函数、Kind 常量三类列出公开符号；不要列变量；每一类必须列出完整成员名称并给出数量；在范围说明里说明 Kind const block 的数量依据。"
EXPECT_CONTAINS="Eval EvalAll RegisteredKinds KindExternalArtifactDecoded"
EXPECT_MATCHES_REGEX="(类型.*(^|[^0-9])3([^0-9]|$)|(^|[^0-9])3([^0-9]|$).*类型)
(函数.*(^|[^0-9])5([^0-9]|$)|(^|[^0-9])5([^0-9]|$).*函数)
(Kind|常量|constant)"
EXPECT_NOT_CONTAINS="defaultExternalArtifactFloor private approximately roughly"
EXPECT_DYNAMIC_SCALARS="exported_types exported_functions kind_constants"
EXPECT_DYNAMIC_SCALAR_COMMAND_EXPORTED_TYPES="awk '/^type [A-Z][A-Za-z0-9_]*/ { n++ } END { print n+0 }' internal/analysis/criterion/grammar.go internal/analysis/criterion/eval.go"
EXPECT_DYNAMIC_SCALAR_DATA_SCOPE_EXPORTED_TYPES="repo_checkout:internal/analysis/criterion/{grammar.go,eval.go};production=true;declaration=exported_type"
EXPECT_DYNAMIC_SCALAR_SURFACE_EXPORTED_TYPES="primary_text"
EXPECT_DYNAMIC_SCALAR_BINDING_REGEX_EXPORTED_TYPES="((类型|type)[^0-9]{0,80}(共[[:space:]]*)?{{VALUE}}[[:space:]]*个)|((共[[:space:]]*)?{{VALUE}}[[:space:]]*个[^0-9]{0,80}(类型|type))"
EXPECT_DYNAMIC_SCALAR_COMMAND_EXPORTED_FUNCTIONS="awk '/^func [A-Z][A-Za-z0-9_]*\\(/ { n++ } END { print n+0 }' internal/analysis/criterion/grammar.go internal/analysis/criterion/eval.go"
EXPECT_DYNAMIC_SCALAR_DATA_SCOPE_EXPORTED_FUNCTIONS="repo_checkout:internal/analysis/criterion/{grammar.go,eval.go};production=true;declaration=exported_function"
EXPECT_DYNAMIC_SCALAR_SURFACE_EXPORTED_FUNCTIONS="primary_text"
EXPECT_DYNAMIC_SCALAR_BINDING_REGEX_EXPORTED_FUNCTIONS="((函数|function)[^0-9]{0,80}(共[[:space:]]*)?{{VALUE}}[[:space:]]*个)|((共[[:space:]]*)?{{VALUE}}[[:space:]]*个[^0-9]{0,80}(函数|function))"
EXPECT_DYNAMIC_SCALAR_COMMAND_KIND_CONSTANTS="awk '/^const \\(/,/^\\)/ { if (\$1 ~ /^Kind[A-Z]/) n++ } END { print n+0 }' internal/analysis/criterion/grammar.go"
EXPECT_DYNAMIC_SCALAR_DATA_SCOPE_KIND_CONSTANTS="repo_checkout:internal/analysis/criterion/grammar.go;production=true;const_block=Kind"
EXPECT_DYNAMIC_SCALAR_SURFACE_KIND_CONSTANTS="primary_text"
EXPECT_DYNAMIC_SCALAR_BINDING_REGEX_KIND_CONSTANTS="((Kind|常量|constant)[^0-9]{0,100}(共[[:space:]]*)?{{VALUE}}[[:space:]]*个)|((共[[:space:]]*)?{{VALUE}}[[:space:]]*个[^0-9]{0,100}(Kind|常量|constant))"
