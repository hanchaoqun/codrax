# Per-user / per-environment config files. Kept next to the binary;
# never committed.
/codrax.yaml
/providers.yaml
/providers.*.yaml
!/providers.yaml.example

# Build output (binary name comes from module path)
/codrax
# `go build ./eval/repomap_v3/harness/` drops a binary at the repo root.
/harness
/.codrax-sweep-*
.DS_Store

# Runtime artifacts produced by the binary itself. Everything created
# by the logger, REPL memory store, and tool blob storage lives under
# .codrax/ so a single rule keeps the workspace clean.
/.codrax/

# Legacy artifact directories from pre-flat layouts. Kept gitignored so
# old clones with existing logs/memory don't accidentally stage them.
/logs/
/memory/

# Eval harness output. Per-run transcripts + per-run log dirs under
# eval/results/ are large, machine-specific, and contain the test
# question verbatim — committing them would also re-introduce the
# keyword-search contamination that ExcludeDirs already guards against.
/eval/results/

# Sweep artifacts produced by eval/parallel_all.sh — regenerated on
# every sweep, never useful to commit.
/eval/parallel_all.log
/eval/parallel_all_summary.md

# Release/download artifacts generated locally while testing packaging.
/docs/download/*.tar.gz
/docs/download/codrax-*/

# Claude Code runtime state — session-specific scheduling lock + local
# settings overlay; both regenerate per machine and must not ship.
/.claude/

# codrax runtime artifacts (logs, memory, blob caches, worktrees, plans)
.codrax/

/dist/
