config/providers.yaml
config/codrax.yaml

# Build output (binary name comes from module path)
/codrax

# Runtime artifacts produced by the binary itself. Both directories are
# created on first run by the logger and REPL; they hold per-session
# state that must never be committed.
/logs/
/memory/

# Eval harness output. Per-run transcripts + per-run log dirs under
# eval/results/ are large, machine-specific, and contain the test
# question verbatim — committing them would also re-introduce the
# keyword-search contamination that ExcludeDirs already guards against.
/eval/results/
