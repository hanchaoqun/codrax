# =============================================================================
# codrax provider credentials  ·  codrax 模型凭证
# Copy to providers.yaml next to the binary.  复制为 providers.yaml,放在二进制同目录。
# =============================================================================
#
# EN  Static API-key setup needs provider/api_key/model/base_url. OAuth
#     setup replaces api_key with auth and may omit model when models_path is
#     configured; codrax then lists models and selects the first one visibly.
#     There is no silent fallback to a public endpoint or hard-coded model ID.
# 中文 静态 API key 模式需要 provider/api_key/model/base_url。OAuth 模式用
#     auth 取代 api_key;如果配置了 models_path,model 可省略,codrax 会展示
#     模型列表并选择第一个。不会偷偷回退到公网地址或硬编码模型 ID。
#
# EN  Two dimensions you can toggle per provider:
#       1. protocol  — HTTP vs HTTPS is decided purely by the base_url
#                      scheme; there is no separate switch.
#       2. streaming — stream: true (default) / false toggles SSE.
#     Stream on/off and HTTP/HTTPS combine freely; see the scenario
#     matrix at the end of this file.
# 中文 每个 provider 有两个可独立切换的维度:
#       1. 协议   —— HTTP / HTTPS 完全由 base_url 的 scheme 决定,没有单独开关。
#       2. 流式   —— stream: true(默认)/ false 切换 SSE 流式响应。
#     流式开关与 HTTP/HTTPS 可自由组合;完整场景见文件末尾的对照表。

llm:
  default:
    # --- Required fields  ·  必填字段 -------------------------------------
    # EN  provider: only the `openai` protocol is implemented. Any
    #     OpenAI-compatible chat-completions backend (deepseek, qwen,
    #     vllm/Ollama, together, ...) connects by pointing base_url at it.
    # 中文 provider:仅实现 `openai` 协议。任何兼容 OpenAI chat-completions
    #     的后端(deepseek、qwen、vllm/Ollama、together 等)只需把
    #     base_url 指向它即可接入。
    provider: openai

    # EN  api_key / model: required for the ordinary static-key setup,
    #     no default assumed. For OAuth setup, see the internal OAuth section
    #     below: api_key is omitted, and model can be omitted only when
    #     models_path is configured.
    # 中文 普通静态 key 模式下 api_key / model 必填,无默认值。OAuth 模式见
    #     下方公司内 OAuth 章节:api_key 省略;只有配置 models_path 时 model
    #     才可省略。
    api_key: "sk-xxx"
    model: "your-model-id"

    # EN  base_url: required. `https://` → TLS; `http://` → plain HTTP.
    #     codrax switches transport transparently by scheme.
    # 中文 base_url:必填。`https://` → 走 TLS;`http://` → 明文 HTTP。
    #     codrax 按 scheme 自动切换传输层。
    base_url: "https://your-endpoint/v1"

    # --- Provider path / OAuth / request decoration  ·  内部 OAuth 接入 ----
    # EN  Most OpenAI-compatible providers keep the default
    #     /chat/completions path and Authorization: Bearer api_key header, so
    #     you do not need this section. Internal OAuth-backed providers can
    #     use OAuth polling, custom paths, request headers, and provider-private
    #     body fields without changing Codrax's tool/SSE parser.
    # 中文 大多数 OpenAI-compatible provider 使用默认 /chat/completions 路径
    #     和 Authorization: Bearer api_key 头,不需要本节。公司内 OAuth
    #     模型网关可配置 OAuth 轮询、自定义路径、请求头和 provider 私有 body
    #     字段,同时复用 Codrax 已有工具调用/SSE 解析。
    #
    # Example / 示例:
    #
    # api_key: ""                                      # OAuth mode does not use static api_key
    # model: ""                                        # optional only when models_path works
    # base_url: "https://your-model-gateway.example.com/api"
    # chat_completions_path: /chat/completions
    # models_path: /models
    # auth:
    #   mode: oauth2_polling                           # api_key | oauth2_polling
    #   auth_base_url: "https://your-sso.example.com/oauth"
    #   client_id: "your-oauth-client-id"
    #   scope: "your-scope"
    #   response_type: code
    #   scope_resource: "your-scope-resource"
    #   authorize_path: /oauth2/authorize
    #   callback_path: /oauth/callback
    #   token_path: /oauth/getToken
    #   access_token_header: X-Auth-Token
    #   access_token_format: "{token}"
    #   token_cache_file: "~/.codrax/auth/internal-oauth-token.json"
    #   poll_timeout_seconds: 1800
    #   poll_interval_seconds: 1
    #   refresh_before_seconds: 300
    # headers:
    #   app-id: "your-app-id"
    #   x-snap-traceid: "@uuid_v4"                     # fresh UUID per request
    # request_extra:
    #   queue: true
    #   tool_stream: true

    # --- Streaming  ·  流式响应 -------------------------------------------
    # EN  Default true (streaming ON): codrax parses SSE, shows a live
    #     preview in the REPL task row, and renders /chat replies as a
    #     live typewriter. Providers that quietly return SSE are also
    #     auto-detected on the JSON path. Set false for the classic
    #     single-shot request-response (useful for local models, or for
    #     CI where byte-stable captures matter).
    # 中文 默认 true(开启流式):codrax 解析 SSE,在 REPL 任务行实时预览,
    #     /chat 回复逐字打印。对于偷偷返回 SSE 的服务,JSON 路径也会自动识别。
    #     设为 false 走经典的单次请求-响应(适合本地模型,或需要字节级稳定
    #     输出的 CI)。
    # stream: false

    # --- Think Aloud directive  ·  出声思考指令 --------------------------
    # EN  When true, codrax appends a "Think Aloud" system section asking
    #     the model to narrate its reasoning before each tool call. Costs
    #     a few hundred tokens per turn but surfaces wrong-direction
    #     starts early so the operator can interrupt sooner. Per-agent
    #     override: nil inherits the default; explicit true/false wins.
    #     Default: nil (treated as false — no Think Aloud section).
    # 中文 设为 true 时,codrax 追加一段 "Think Aloud" 系统提示,要求模型在
    #     每次工具调用前叙述推理过程。每轮多花几百 token,但能让"方向跑偏"
    #     更早暴露,便于及时打断。按 agent 覆盖:nil 继承默认,显式 true/false
    #     生效。默认 nil(视为 false,不注入该段)。
    # think_aloud: false

    # --- Provider-native thinking mode  ·  Provider 原生思考模式 --------
    # EN  Separate from think_aloud. `think_aloud` is only a Codrax
    #     prompt-side narration hint; it does NOT request provider
    #     reasoning mode. This field controls provider-specific wire
    #     JSON when supported. Default `auto`: for official DeepSeek
    #     API endpoints Codrax sends `thinking: {type: disabled}` because
    #     DeepSeek defaults thinking to enabled and thinking+tools require
    #     reasoning_content round-tripping. Other OpenAI-compatible
    #     providers receive no private thinking field unless explicitly
    #     configured.
    # 中文 与 think_aloud 分离。`think_aloud` 只是 Codrax 自己的 prompt
    #     侧“出声思考”提示,不会请求 provider 原生思考模式。本字段控制
    #     支持该能力的 provider wire JSON。默认 `auto`: 对官方 DeepSeek
    #     API endpoint 主动发送 `thinking: {type: disabled}`,因为 DeepSeek
    #     默认开启 thinking,而 thinking+tools 需要回传 reasoning_content。
    #     其它 OpenAI-compatible provider 默认不接收这个私有字段。不要用
    #     `think_aloud: false` 修 provider 原生 thinking/tool_choice 错误;
    #     `think_aloud` 只控制 prompt 侧进度摘要。
    #     `enabled` is opt-in for operators who deliberately want provider
    #     reasoning. On official DeepSeek endpoints Codrax will preserve
    #     and round-trip `reasoning_content` on tool-call turns and omit
    #     `tool_choice` while native thinking is enabled, matching DeepSeek's
    #     tool-call compatibility requirements. Keep `auto` unless you have
    #     measured that native thinking improves your provider.
    # 中文 `enabled` 是显式选择:仅当你确实想使用 provider 原生思考时开启。
    #     对官方 DeepSeek endpoint,Codrax 会在工具调用轮次保留并回传
    #     `reasoning_content`,且在原生 thinking 开启时不发送 `tool_choice`,
    #     以满足 DeepSeek 的工具调用兼容要求。除非你验证过原生 thinking
    #     对当前 provider 有收益,否则保持 `auto`。
    # thinking_mode: auto                  # auto | disabled | enabled | provider_default

    # --- Tool-call compatibility  ·  工具调用兼容 ------------------------
    # EN  codrax always runs one strict transport-safety recovery: if
    #     assistant content is exactly a valid JSON tool-call envelope
    #     for a known tool, it is lifted into protocol-level tool_calls.
    #     recover_text_tool_calls enables the WIDER local-model mode:
    #     fenced/embedded tool-call JSON, bare-args recovery in
    #     required-tool turns, and small JSON repairs. Default false —
    #     enable only for providers that need it.
    # 中文 codrax 总会做一次严格的传输安全修复:若 assistant 正文恰好是某个
    #     已知工具的合法 JSON 工具调用信封,会被提升为协议级 tool_calls。
    #     recover_text_tool_calls 开启更宽松的本地模型兼容模式:围栏/内嵌的
    #     工具调用 JSON、required-tool 轮次的裸参数恢复、小幅 JSON 修复。
    #     默认 false —— 仅对确实需要的 provider 开启。
    # recover_text_tool_calls: false

    # EN  tool_param_compat: schema-aware repair for models that DO return
    #     protocol tool_calls but put mechanically wrong JSON value types
    #     in arguments, e.g. {"offset":"146"} when the schema says integer.
    #     It never fills missing fields, drops unknown keys, repairs prose,
    #     or maps enum synonyms. Default: mode repair, split_string_arrays
    #     false (only schema-proven equivalence repairs run). mode: off
    #     disables; audit logs repairable payloads without changing
    #     execution; split_string_arrays: true helps local/small models
    #     that emit comma/newline-delimited string arrays.
    # 中文 tool_param_compat:针对"能返回协议级 tool_calls、但参数里 JSON 值
    #     类型机械性写错"的模型(如 schema 要 integer 却给 {"offset":"146"})
    #     做按 schema 的修复。它绝不补缺失字段、不删未知键、不改散文、不映射
    #     枚举近义词。默认 mode=repair、split_string_arrays=false(只做 schema
    #     可证明的等价修复)。mode: off 关闭;audit 只记录可修复的载荷、不改
    #     执行;split_string_arrays: true 适合会输出逗号/换行分隔字符串数组的
    #     本地小模型。
    # tool_param_compat:
    #   mode: repair                        # off | audit | repair
    #   split_string_arrays: false

    # --- TLS (HTTPS endpoints only)  ·  TLS(仅 HTTPS) -------------------
    # EN  These fields have no effect when base_url uses `http://`.
    #     Set tls_ca_file only when the endpoint uses a corporate /
    #     self-signed CA not in the system trust pool (typical symptom:
    #     `x509: certificate signed by unknown authority`).
    # 中文 base_url 为 `http://` 时这些字段无效。仅当端点使用系统信任库里
    #     没有的企业/自签 CA 时才设 tls_ca_file(典型报错:
    #     `x509: certificate signed by unknown authority`)。
    # tls_ca_file: /etc/pki/ca-trust/extracted/pem/corp-bundle.pem

    # EN  tls_insecure_skip_verify: nuclear escape — disables ALL
    #     certificate validation; any on-path attacker can steal the API
    #     key. Use only for short-lived debugging against an endpoint you
    #     fully control, and prefer tls_ca_file. codrax logs a
    #     high-visibility warning every startup while true.
    # 中文 tls_insecure_skip_verify:核选项 —— 关闭全部证书校验;任何中间人
    #     都能窃取 API key。仅用于针对你完全掌控的端点做短时调试,优先用
    #     tls_ca_file。开启期间 codrax 每次启动都会打高亮警告。
    # tls_insecure_skip_verify: false

    # --- Sizing / timeout / retry  ·  容量 / 超时 / 重试 ------------------
    # EN  All optional and per-agent inheritable. Zero / unset on any
    #     field means "use the code default".
    #
    #   context_window:        max input tokens the model accepts. Drives
    #                          the context-pressure watchdog and the
    #                          fraction-form sizing knobs. Code default
    #                          200000 when unset.
    #   max_output_tokens:     wire-level `max_tokens`. 0 / unset means
    #                          "don't send the field" — the server uses
    #                          the model's own ceiling (recommended;
    #                          capping client-side caused streaming
    #                          truncation of large emit calls).
    #   max_output_fraction:   alternative form: fraction × context_window.
    #                          Used only if non-zero AND max_output_tokens
    #                          is zero.
    #   request_timeout_seconds:        non-streaming HTTP timeout.
    #                                   Code default 240.
    #   retry_max_attempts:             transient 429 / 5xx retry cap.
    #                                   Code default 6.
    #   stream_stall_timeout_seconds:   SSE no-bytes ceiling AFTER the
    #                                   first chunk (mid-stream pauses).
    #                                   Default 120. Deep-thinking models
    #                                   routinely pause 60+s between
    #                                   thinking blocks — keep 90-120s on
    #                                   those, lower (15-30s) on fast
    #                                   small models.
    #   stream_first_byte_timeout_seconds: ceiling that applies BEFORE the
    #                                   first SSE chunk — catches "request
    #                                   accepted, server never speaks"
    #                                   (provider deadlock, middlebox,
    #                                   model cold-start). Default 40.
    # 中文 全部可选,可按 agent 继承。任一字段为 0 / 未设即"使用代码默认值"。
    #
    #   context_window:        模型可接受的最大输入 token 数。驱动上下文压力
    #                          看门狗与按比例的容量旋钮。未设时代码默认 200000。
    #   max_output_tokens:     wire 层 `max_tokens`。0 / 未设表示"不发该字段",
    #                          由服务端用模型自身上限(推荐;客户端封顶曾导致
    #                          大 emit 调用的流式截断)。
    #   max_output_fraction:   替代写法:比例 × context_window。仅当它非零且
    #                          max_output_tokens 为零时生效。
    #   request_timeout_seconds:        非流式 HTTP 超时。代码默认 240。
    #   retry_max_attempts:             429 / 5xx 瞬时重试上限。代码默认 6。
    #   stream_stall_timeout_seconds:   首个分片到达后的 SSE 无字节上限(应对
    #                                   流中途停顿)。默认 120。深度思考模型
    #                                   常在思考块之间停顿 60 秒以上 —— 这类
    #                                   保持 90-120 秒,快速小模型可降到 15-30 秒。
    #   stream_first_byte_timeout_seconds: 首个 SSE 分片之前的上限 —— 捕捉
    #                                   "请求被接受、服务端始终不说话"(provider
    #                                   死锁、中间盒干扰、模型冷启动卡住)。默认 40。
    #
    # context_window: 200000
    # max_output_tokens: 0
    # max_output_fraction: 0.5
    # request_timeout_seconds: 240
    # retry_max_attempts: 6
    # stream_stall_timeout_seconds: 120
    # stream_first_byte_timeout_seconds: 40

  # --- Per-agent overrides  ·  按 agent 覆盖 -------------------------------
  # EN  Valid agent keys: analyzer, explorer, extractor, finalizer,
  #     log_triager, perf_triager, planner, coder, verifier, plus the
  #     optional memory_summarizer, chitchat_responder, chitchat_classifier,
  #     env_recommender, reflector, plan_critic. Set only the fields you
  #     want to change; unset fields inherit from default.
  # 中文 合法的 agent 名:analyzer、explorer、extractor、finalizer、
  #     log_triager、perf_triager、planner、coder、verifier,以及可选的
  #     memory_summarizer、chitchat_responder、chitchat_classifier、
  #     env_recommender、reflector、plan_critic。只填想改的字段,其余继承 default。
  #
  # EN  Each agent can also declare `<name>_fallback` — a secondary
  #     provider the FallbackAdapter swaps to when the primary returns a
  #     RETRYABLE error (EOF / stream stalled / 429 / 5xx / network blip).
  #     Non-retryable errors (auth / schema / config bugs) do NOT trigger
  #     fallback — they surface verbatim. The fallback inherits from
  #     `default` like any agent; declare only what differs.
  # 中文 每个 agent 还能声明 `<name>_fallback` —— 一个备用 provider,当主
  #     provider 返回可重试错误(EOF / 流卡死 / 429 / 5xx / 网络抖动)时,
  #     FallbackAdapter 会自动切过去。不可重试错误(鉴权 / schema / 配置错误)
  #     不触发 fallback —— 原样抛出。fallback 与普通 agent 一样继承 `default`,
  #     只需声明不同的字段。
  #
  # agents:
  #   analyzer:
  #     model: "stronger-model"           # smarter model for classification
  #   extractor:
  #     model: "cheaper-model"            # cheaper model for structuring
  #   finalizer:
  #     base_url: "http://localhost:11434/v1"
  #     model: "llama3.1:70b"
  #     stream: false                     # per-agent opt-out (default on)
  #   finalizer_fallback:                 # auto-swap on EOF / 429 / blip
  #     api_key: "sk-cheap-..."
  #     base_url: "https://other-provider/v1"
  #     model: "cheap-but-stable-model"
  #   planner_fallback:                   # any agent name supports _fallback
  #     model: "smaller-but-stable-model"

# =============================================================================
# Scenario matrix  ·  场景对照表
# =============================================================================
# | Deployment / 部署形态        | base_url   | stream     | tls_*               |
# |------------------------------|------------|------------|---------------------|
# | Public cloud LLM / 公有云    | https://…  | true/false | —                   |
# |   (OpenAI, DeepSeek, Qwen…)  |            |            |                     |
# | Corporate HTTPS + self-CA /  | https://…  | true/false | tls_ca_file         |
# |   企业 HTTPS + 自签 CA       |            |            |                     |
# | HTTPS cert unresolvable,     | https://…  | true/false | tls_insecure_skip_  |
# |   temporary debug / 临时调试 |            |            |   verify: true      |
# | Local Ollama / vLLM / 本地   | http://…   | true/false | —                   |
# | Internal HTTP proxy / 内网   | http://…   | true/false | —                   |
# | Provider forces SSE even     | either     | either     | — (auto-detected /  |
# |   when stream:false / 强制 SSE|           |            |   自动识别)         |
