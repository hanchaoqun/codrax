# =============================================================================
# codrax provider credentials — copy to providers.yaml next to the binary.
# =============================================================================
#
# All four required fields listed below MUST be set on the default
# provider. codrax refuses to start if any is missing — there is no
# silent fallback to a public endpoint or a hard-coded model ID.
# Per-agent overrides inherit any field you do not explicitly set.
#
# Two dimensions you can toggle per provider:
#
#   1. protocol    — HTTP vs HTTPS is decided purely by the
#                    base_url scheme. No separate switch exists.
#   2. streaming   — stream: true (default) / false toggles SSE;
#                    the REPL surfaces a live content preview when
#                    on and /chat renders a live typewriter reply.
#
# Stream on/off and HTTP/HTTPS combine freely. See the end of this
# file for the full scenario matrix.

llm:
  default:
    # --- Required fields --------------------------------------------------
    provider: openai                      # only `openai` is implemented; any
                                          # compatible chat-completions backend
                                          # plugs in via base_url (deepseek,
                                          # qwen, vllm/Ollama, together, etc.)
    api_key: "sk-xxx"                     # required
    model: "your-model-id"                # required; no default assumed
    base_url: "https://your-endpoint/v1"  # required; no default assumed.
                                          # `https://` → TLS; `http://` → plain
                                          # HTTP. codrax switches transparently.

    # --- Streaming -------------------------------------------------------
    # Default: true (streaming ON). codrax sets `stream: true` on the
    # wire, parses SSE, shows a live preview in the REPL task row, and
    # renders /chat replies as a live typewriter. Providers that quietly
    # return SSE are auto-detected on the JSON path as well, so even
    # stream: false cannot break on an SSE-forcing provider. Set to
    # false to fall back to the classic single-shot request-response
    # (useful for local models where streaming adds no perceptible
    # latency win, or for CI where byte-stable captures matter).
    # stream: false

    # --- Think Aloud directive -------------------------------------------
    # When true, codrax appends a "Think Aloud" system section that asks
    # the model to narrate its reasoning step-by-step BEFORE issuing the
    # next tool call. Adds a few hundred extra tokens per turn but tends
    # to surface obvious wrong-direction starts so the operator can
    # interrupt sooner. Useful with reasoning models that don't expose
    # an internal scratchpad, or when comparing two models head-to-head
    # in dev. Per-agent override: nil inherits from default; explicit
    # true/false wins.
    # Default: nil (treated as false in the assembler — no Think Aloud
    # section emitted).
    # think_aloud: false

    # --- TLS (HTTPS endpoints only) --------------------------------------
    # These fields have no effect when base_url uses `http://`.
    # Set tls_ca_file only when the endpoint uses a corporate /
    # self-signed CA not in the system trust pool (typical symptom:
    # `x509: certificate signed by unknown authority`).
    # tls_ca_file: /etc/pki/ca-trust/extracted/pem/corp-bundle.pem

    # Nuclear escape — disables ALL certificate validation; any on-path
    # attacker can steal the API key. Only use for short-lived
    # debugging against an endpoint you fully control, and prefer
    # tls_ca_file whenever possible. codrax logs a high-visibility
    # warning on stderr + log every startup while true.
    # tls_insecure_skip_verify: false

    # --- Sizing knobs (all optional; per-provider, per-agent inheritable)
    # Zero / unset on any field means "use the code default".
    #
    # context_window:        max input tokens the model accepts. Affects
    #                        the agent's context-pressure watchdog and
    #                        the fraction-form max_output_fraction.
    #                        Code default 128000 when unset.
    # max_output_tokens:     wire-level `max_tokens`. 0 / unset means
    #                        "don't send the field" — server uses the
    #                        model's own ceiling (the recommended
    #                        default; capping client-side caused
    #                        emit_change_plan streaming truncation).
    # max_output_fraction:   alternative form: fraction × context_window.
    #                        Used only if non-zero AND max_output_tokens
    #                        is zero.
    # request_timeout_seconds: outer HTTP timeout for non-streaming
    #                        requests. Code default 120s.
    # retry_max_attempts:    transient 429 / 5xx retry cap. Code
    #                        default 6 (≈62s of total backoff
    #                        coverage at base = 2s exponential).
    # stream_stall_timeout_seconds: SSE no-bytes ceiling AFTER the
    #                        first chunk arrives — for mid-stream
    #                        pauses. 60s default; deep-thinking
    #                        models routinely pause 30+ s between
    #                        thinking blocks, so set higher (90-
    #                        120s) on those and lower (15-30s) on
    #                        fast small models.
    # stream_first_byte_timeout_seconds: distinct ceiling that
    #                        applies BEFORE the first SSE chunk —
    #                        catches "request accepted, server
    #                        never speaks" (provider deadlock,
    #                        middlebox interference, model cold-
    #                        start hang). 20s default. Healthy
    #                        providers serve first byte in 100-
    #                        500ms; raise only when chasing a
    #                        provider-specific cold-start spike.
    #
    # context_window: 128000
    # max_output_tokens: 0
    # max_output_fraction: 0.5
    # request_timeout_seconds: 120
    # retry_max_attempts: 6
    # stream_stall_timeout_seconds: 60
    # stream_first_byte_timeout_seconds: 20

  # --- Per-agent overrides ------------------------------------------------
  # Valid agent keys are `analyzer`, `explorer`, `extractor`,
  # `finalizer`, `log_triager`, `perf_triager`, `planner`, `coder`,
  # `verifier`, plus the optional `memory_summarizer`,
  # `chitchat_responder`, `chitchat_classifier`, `env_recommender`,
  # `reflector`. Set only the fields you want to change; unset
  # fields inherit from default.
  #
  # Each agent can also declare `<name>_fallback` — a secondary
  # provider that the FallbackAdapter swaps to when the primary
  # returns a retryable error (EOF / stream stalled / 429 / 5xx /
  # network blip). Non-retryable errors (auth / schema / config
  # bugs) DO NOT trigger fallback — they surface verbatim so the
  # operator sees the real diagnostic. Useful for:
  #   - Provider region outage tolerance (premium primary, stable
  #     secondary)
  #   - Flaky upstream connection (premium model on shaky link,
  #     cheap stable model as cushion)
  # The fallback's config inherits from `default` like any agent;
  # only declare what differs (api_key / base_url / model).
  #
  # agents:
  #   analyzer:
  #     model: "stronger-model"           # smarter model for classification
  #   extractor:
  #     model: "cheaper-model"            # cheaper model for structuring
  #   perf_triager:
  #     model: "cheaper-model"            # HiTrace parsing is structurally simple
  #   finalizer:
  #     base_url: "http://localhost:11434/v1"
  #     model: "llama3.1:70b"
  #     stream: false                     # per-agent opt-out (default is on)
  #   finalizer_fallback:                 # auto-swap on EOF / 429 / network blip
  #     api_key: "sk-cheap-..."
  #     base_url: "https://other-provider/v1"
  #     model: "cheap-but-stable-model"
  #   planner_fallback:                   # any agent name supports _fallback
  #     model: "smaller-but-stable-model"

# =============================================================================
# Scenario matrix
# =============================================================================
# | Deployment                  | base_url     | stream      | tls_*               |
# |-----------------------------|--------------|-------------|---------------------|
# | Public cloud LLM (OpenAI,   | https://…    | true/false  | —                   |
# |  DeepSeek, Qwen, Anthropic  |              |             |                     |
# |  via proxy, …)              |              |             |                     |
# | Corporate HTTPS + self-CA   | https://…    | true/false  | tls_ca_file         |
# | HTTPS cert unresolvable,    | https://…    | true/false  | tls_insecure_skip_  |
# |  temporary debugging        |              |             |  verify: true       |
# | Local Ollama / vLLM         | http://…     | true/false  | —                   |
# | Internal HTTP proxy         | http://…     | true/false  | —                   |
# | Provider forces SSE even    | either       | either      | —                   |
# |  when stream: false         |              |             | (auto-detected)     |
